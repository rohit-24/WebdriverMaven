import os
import json

def merge_reports(folder, save_merged=True):
    all_data = []
    for file in os.listdir(folder):
        if file.endswith(".json") and not file.startswith("merged_"):
            path = os.path.join(folder, file)
            with open(path, "r") as f:
                try:
                    all_data.extend(json.load(f))
                except Exception as e:
                    print(f"Error reading {file}: {e}")

    # Save merged file if enabled
    if save_merged:
        merged_path = os.path.join(folder, "merged_karate_report.json")
        with open(merged_path, "w", encoding="utf-8") as f:
            json.dump(all_data, f, indent=2)
        print(f"✅ Merged report saved to: {merged_path}")

    return all_data
