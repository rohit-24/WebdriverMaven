After(async function (this: ScenarioWorld, { result }: ITestCaseHookParameter) {
  try {
    if (result?.status === 'failed') {

      // safe screenshot
      if (this.page && !this.page.isClosed()) {
        try {
          const image = await this.page.screenshot({ fullPage: true });
          if (image) this.attach(image, "image/png");
        } catch (e) {
          console.log("Screenshot skipped - page closed");
        }
      }

      // safe tracing stop
      if (process.env.CI && this.context && !this.context.isClosed?.()) {
        try {
          await this.context.tracing.stop({
            path: `${tracesDir}/${this.testName}-trace.zip`,
          });
        } catch (e) {
          console.log("Trace stop skipped - context closed");
        }
      }
    }
  } catch (err) {
    console.log("Error in After hook =>", err);
  }
});
