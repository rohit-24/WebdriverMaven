## MODIFY — `src/config/configLoader.js`

Reconstructed based on the doc comment in your `README.md` (Image 7: *"merges environments.json + applications.json -> flat 'targets' list"*). Add the middleware-specific flattening as one more branch alongside however the `ui` checkType is currently built:

```js
function getTargets({ checkType }) {
  const applications = require('../../config/applications.json');
  const environments = require('../../config/environments.json');

  const targets = [];

  for (const app of applications) {
    if (!app.enabled) continue;
    if (!app.checks[checkType]) continue;

    for (const [envId, envConfig] of Object.entries(app.environments)) {
      const envMeta = environments[envId];
      if (!envMeta || !envMeta.enabled) continue;

      const baseTarget = {
        appId: app.id,
        appName: app.name,
        env: envId,
        tier: envMeta.tier,
        auth: app.auth
      };

      if (checkType === 'ui') {
        targets.push({
          ...baseTarget,
          loginUrl: envConfig.loginUrl,
          homeUrl: envConfig.homeUrl,
          logoutUrl: envConfig.logoutUrl
        });
      }

      // NEW: middleware checkType branch
      if (checkType === 'middleware') {
        if (!envConfig.wasConsoleUrl) {
          throw new Error(`Missing wasConsoleUrl for ${app.id}/${envId} - check config/applications.json`);
        }
        targets.push({
          ...baseTarget,
          wasConsoleUrl: envConfig.wasConsoleUrl,
          middleware: app.middleware   // { credentialKey, minExpectedServers }
        });
      }

      // Phases 2/4/5 (infra/db/config) would add their own branches here later.
    }
  }

  return targets;
}

module.exports = { getTargets };
```

> ⚠️ This assumes your real `configLoader.js` already loops applications → environments in roughly this shape. If the actual structure differs (e.g. it builds one generic target object and lets each spec pick fields off it), just add the `wasConsoleUrl` / `middleware` fields to whatever the existing generic target-building step is — same idea, adjust to match.

