import pandas as pd
import numpy as np
import time


# ============================================================
# CONFIGURATION
# ============================================================

SOURCE_FILE = "source.xlsx"
TARGET_FILE = "target.xlsx"

OUTPUT_FILE = "reconciliation_result.xlsx"

# Your actual unique ID column
UNIQUE_ID_COLUMN = "UNIQUE"

# Columns you DON'T want to compare.
# Normally keep this empty.
IGNORE_COLUMNS = [
    # "LAST_UPDATED_TIMESTAMP",
    # "SYSTEM_TIMESTAMP",
]

# Numeric tolerance.
#
# 37.21999999999999 vs 37.22
# will be considered equal.
NUMERIC_TOLERANCE = 0.000001

# Text comparison:
# True  = "ABC" and "abc" are considered equal
# False = case matters
IGNORE_TEXT_CASE = True


# ============================================================
# START
# ============================================================

start_time = time.time()

print()
print("=" * 60)
print("        EXCEL RECONCILIATION STARTED")
print("=" * 60)


# ============================================================
# READ FILES
# ============================================================

print("\nReading source file...")

source = pd.read_excel(
    SOURCE_FILE,
    dtype=object
)

print("Reading target file...")

target = pd.read_excel(
    TARGET_FILE,
    dtype=object
)

print(f"\nSource rows : {len(source):,}")
print(f"Target rows : {len(target):,}")


# ============================================================
# CLEAN COLUMN NAMES
# ============================================================

source.columns = (
    source.columns
    .astype(str)
    .str.strip()
)

target.columns = (
    target.columns
    .astype(str)
    .str.strip()
)


# ============================================================
# VALIDATE UNIQUE ID
# ============================================================

if UNIQUE_ID_COLUMN not in source.columns:
    raise ValueError(
        f"'{UNIQUE_ID_COLUMN}' not found in SOURCE file."
    )

if UNIQUE_ID_COLUMN not in target.columns:
    raise ValueError(
        f"'{UNIQUE_ID_COLUMN}' not found in TARGET file."
    )


# ============================================================
# NORMALIZE UNIQUE ID
# ============================================================

def normalize_id(value):

    if pd.isna(value):
        return None

    value = str(value).strip()

    if value == "":
        return None

    # Handle values such as:
    # 12345.0 -> 12345
    try:
        number = float(value)

        if number.is_integer():
            return str(int(number))

    except (ValueError, TypeError):
        pass

    return value


print("\nNormalizing IDs...")

source["_COMPARE_ID"] = (
    source[UNIQUE_ID_COLUMN]
    .map(normalize_id)
)

target["_COMPARE_ID"] = (
    target[UNIQUE_ID_COLUMN]
    .map(normalize_id)
)


# ============================================================
# DUPLICATE CHECK
# ============================================================

source_duplicate_count = (
    source["_COMPARE_ID"]
    .duplicated()
    .sum()
)

target_duplicate_count = (
    target["_COMPARE_ID"]
    .duplicated()
    .sum()
)

print("\nDuplicate ID check:")

print(
    f"Source duplicate IDs : "
    f"{source_duplicate_count:,}"
)

print(
    f"Target duplicate IDs : "
    f"{target_duplicate_count:,}"
)


if source_duplicate_count > 0 or target_duplicate_count > 0:

    print("\nERROR:")
    print(
        "The ID is not unique in one or both files."
    )

    print(
        "The program will stop instead of producing "
        "a potentially incorrect many-to-many comparison."
    )

    raise SystemExit


# ============================================================
# FIND COMMON COLUMNS
# ============================================================

source_columns = set(source.columns)
target_columns = set(target.columns)

common_columns = (
    source_columns
    & target_columns
)

# Internal comparison column
common_columns.discard("_COMPARE_ID")

# ID itself does not need to be compared
common_columns.discard(UNIQUE_ID_COLUMN)

# Ignore configured columns
compare_columns = sorted(
    [
        column
        for column in common_columns
        if column not in IGNORE_COLUMNS
    ]
)

source_only_columns = sorted(
    source_columns - target_columns
)

target_only_columns = sorted(
    target_columns - source_columns
)


print("\n" + "=" * 60)
print("COLUMN ANALYSIS")
print("=" * 60)

print(
    f"Columns being compared : "
    f"{len(compare_columns)}"
)

print(
    f"Columns ignored        : "
    f"{len(IGNORE_COLUMNS)}"
)

print(
    f"Source-only columns    : "
    f"{len(source_only_columns)}"
)

print(
    f"Target-only columns    : "
    f"{len(target_only_columns)}"
)


# ============================================================
# SET ID AS INDEX
# ============================================================

print("\nAligning records by ID...")

source_indexed = (
    source
    .set_index("_COMPARE_ID")
)

target_indexed = (
    target
    .set_index("_COMPARE_ID")
)


# ============================================================
# FIND ID DIFFERENCES
# ============================================================

source_ids = set(source_indexed.index)
target_ids = set(target_indexed.index)

common_ids = source_ids & target_ids

missing_ids = source_ids - target_ids
extra_ids = target_ids - source_ids


print(
    f"Records present in both : "
    f"{len(common_ids):,}"
)

print(
    f"Missing in target       : "
    f"{len(missing_ids):,}"
)

print(
    f"Extra in target         : "
    f"{len(extra_ids):,}"
)


# ============================================================
# ALIGN ONLY COMMON RECORDS
# ============================================================

common_id_list = list(common_ids)

source_common = (
    source_indexed
    .loc[common_id_list]
)

target_common = (
    target_indexed
    .loc[common_id_list]
)


# ============================================================
# NORMALIZATION FUNCTION
# ============================================================

def normalize_series(series):

    # Convert to object so we can safely manipulate values
    result = series.copy()

    # Strip whitespace from text
    result = result.map(
        lambda x:
        x.strip()
        if isinstance(x, str)
        else x
    )

    # Convert empty strings to NaN
    result = result.replace(
        r"^\s*$",
        np.nan,
        regex=True
    )

    return result


# ============================================================
# COLUMN COMPARISON
# ============================================================

print("\nComparing values...")

mismatch_frames = []

column_mismatch_counts = []


for column in compare_columns:

    source_values = normalize_series(
        source_common[column]
    )

    target_values = normalize_series(
        target_common[column]
    )

    # --------------------------------------------------------
    # Identify numeric values
    # --------------------------------------------------------

    source_numeric = pd.to_numeric(
        source_values,
        errors="coerce"
    )

    target_numeric = pd.to_numeric(
        target_values,
        errors="coerce"
    )

    both_numeric = (
        source_numeric.notna()
        & target_numeric.notna()
    )

    # --------------------------------------------------------
    # Start with exact comparison
    # --------------------------------------------------------

    equal = (
        source_values.eq(target_values)
    )

    # --------------------------------------------------------
    # Handle numeric values
    #
    # Example:
    #
    # 37.21999999999999
    # 37.22
    #
    # --------------------------------------------------------

    numeric_equal = np.isclose(
        source_numeric,
        target_numeric,
        atol=NUMERIC_TOLERANCE,
        rtol=0,
        equal_nan=False
    )

    equal = (
        equal
        | (
            both_numeric
            & numeric_equal
        )
    )

    # --------------------------------------------------------
    # Handle text case
    # --------------------------------------------------------

    if IGNORE_TEXT_CASE:

        source_text = (
            source_values
            .astype("string")
            .str.lower()
        )

        target_text = (
            target_values
            .astype("string")
            .str.lower()
        )

        text_equal = (
            source_text.eq(target_text)
        )

        equal = (
            equal
            | text_equal
        )

    # --------------------------------------------------------
    # Both empty = equal
    # --------------------------------------------------------

    both_empty = (
        source_values.isna()
        & target_values.isna()
    )

    equal = (
        equal
        | both_empty
    )

    # --------------------------------------------------------
    # Find mismatches
    # --------------------------------------------------------

    mismatch_mask = ~equal

    mismatch_count = (
        mismatch_mask.sum()
    )

    column_mismatch_counts.append({
        "Column": column,
        "Mismatch_Count": int(
            mismatch_count
        )
    })

    # --------------------------------------------------------
    # Only create rows for actual mismatches
    # --------------------------------------------------------

    if mismatch_count > 0:

        mismatch_data = pd.DataFrame({
            UNIQUE_ID_COLUMN:
                source_common.index[
                    mismatch_mask
                ],

            "Column":
                column,

            "Source_Value":
                source_values[
                    mismatch_mask
                ].values,

            "Target_Value":
                target_values[
                    mismatch_mask
                ].values
        })

        mismatch_frames.append(
            mismatch_data
        )


# ============================================================
# COMBINE MISMATCHES
# ============================================================

print("\nBuilding mismatch report...")

if mismatch_frames:

    mismatches = pd.concat(
        mismatch_frames,
        ignore_index=True
    )

else:

    mismatches = pd.DataFrame(
        columns=[
            UNIQUE_ID_COLUMN,
            "Column",
            "Source_Value",
            "Target_Value"
        ]
    )


# ============================================================
# RECORD LEVEL RESULTS
# ============================================================

if len(mismatches) > 0:

    mismatched_ids = set(
        mismatches[UNIQUE_ID_COLUMN]
    )

else:

    mismatched_ids = set()


exact_match_count = (
    len(common_ids)
    - len(mismatched_ids)
)


# ============================================================
# ALL RESULTS
# ============================================================

all_results = pd.DataFrame({

    UNIQUE_ID_COLUMN:
        list(common_ids)

})

all_results["Result"] = np.where(
    all_results[UNIQUE_ID_COLUMN]
    .isin(mismatched_ids),

    "MISMATCH",

    "MATCH"
)


# ============================================================
# MISSING / EXTRA REPORT
# ============================================================

missing_output = pd.DataFrame({

    UNIQUE_ID_COLUMN:
        list(missing_ids)

})

extra_output = pd.DataFrame({

    UNIQUE_ID_COLUMN:
        list(extra_ids)

})


# ============================================================
# COLUMN SUMMARY
# ============================================================

column_summary = pd.DataFrame(
    column_mismatch_counts
)

column_summary = (
    column_summary
    .sort_values(
        "Mismatch_Count",
        ascending=False
    )
)


# ============================================================
# SUMMARY
# ============================================================

summary = pd.DataFrame({

    "Metric": [

        "Source Records",

        "Target Records",

        "Records Present In Both",

        "Exact Matches",

        "Records With Mismatch",

        "Missing In Target",

        "Extra In Target",

        "Columns Compared"

    ],

    "Count": [

        len(source),

        len(target),

        len(common_ids),

        exact_match_count,

        len(mismatched_ids),

        len(missing_ids),

        len(extra_ids),

        len(compare_columns)

    ]

})


# ============================================================
# WRITE REPORT
# ============================================================

print("\nCreating Excel report...")

with pd.ExcelWriter(
    OUTPUT_FILE,
    engine="openpyxl"
) as writer:

    summary.to_excel(
        writer,
        sheet_name="Summary",
        index=False
    )

    mismatches.to_excel(
        writer,
        sheet_name="Mismatches",
        index=False
    )

    missing_output.to_excel(
        writer,
        sheet_name="Missing_In_Target",
        index=False
    )

    extra_output.to_excel(
        writer,
        sheet_name="Extra_In_Target",
        index=False
    )

    column_summary.to_excel(
        writer,
        sheet_name="Column_Summary",
        index=False
    )

    all_results.to_excel(
        writer,
        sheet_name="All_Results",
        index=False
    )


# ============================================================
# FINAL OUTPUT
# ============================================================

execution_time = (
    time.time() - start_time
)

print()
print("=" * 60)
print("       RECONCILIATION COMPLETED")
print("=" * 60)

print(
    f"Source records        : "
    f"{len(source):,}"
)

print(
    f"Target records        : "
    f"{len(target):,}"
)

print(
    f"Records present in both: "
    f"{len(common_ids):,}"
)

print(
    f"Exact matches         : "
    f"{exact_match_count:,}"
)

print(
    f"Records with mismatch : "
    f"{len(mismatched_ids):,}"
)

print(
    f"Missing in target     : "
    f"{len(missing_ids):,}"
)

print(
    f"Extra in target       : "
    f"{len(extra_ids):,}"
)

print(
    f"Columns compared      : "
    f"{len(compare_columns):,}"
)

print(
    f"Execution time        : "
    f"{execution_time:.2f} seconds"
)

print()
print(
    f"Report generated: {OUTPUT_FILE}"
)
