import "dotenv/config";
import { GatewayLLM } from "./GatewayLLM.js";
import { createReactAgent } from "@langchain/langgraph/prebuilt";
import { getWeatherTool } from "./weatherTool.js";

async function main() {
  // 1️⃣ Initialize LLM
  const llm = new GatewayLLM();

  // 2️⃣ Create agent with tools
  const agent = createReactAgent({
    llm,
    tools: [getWeatherTool],
  });

  // 3️⃣ Ask a question that requires the tool
  const response = await agent.invoke({
    messages: [
      {
        role: "user",
        content: "What is the weather in Singapore?",
      },
    ],
  });

  // 4️⃣ Print final agent response
  console.log(response.messages.at(-1)?.content);
}

main().catch(console.error);
