
import os
import json
from utils.get_token import get_token
from langchain_core.messages import HumanMessage
from models.claude_model import ClaudeModel
from models.gemini_model import GeminiModel

# Configuration
BEARER_TOKEN = get_token()
DEFAULT_MODEL = "claude"  # Change to "gemini" if needed
REPORT_PATH = "regressionAnalysisAgent/regression_report/karate_report.json"

# --- Get model instance ---
def get_model(model_type: str):
    from config import config
    if model_type == "claude":
        return ClaudeModel(model_name=config.CLAUDE_MODEL_ID, project_id=config.PROJECT_ID, api_key=BEARER_TOKEN)
    elif model_type == "gemini":
        return GeminiModel(model_name=config.GEMINI_MODEL_ID, project_id=config.PROJECT_ID, api_key=BEARER_TOKEN)
    else:
        raise ValueError("❌ Unsupported model type. Use 'claude' or 'gemini'.")

# --- Load Karate JSON Report ---
def load_json_report(file_path):
    if not os.path.exists(file_path):
        print(f"❌ JSON file not found: {file_path}")
        return None
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except json.JSONDecodeError:
        print(f"❌ Invalid JSON format in: {file_path}")
        return None

# --- Build LLM Prompt ---
def build_prompt(user_question, json_data):
    return f"""
You are an intelligent AI test analyst.

Below is the Karate API test report in JSON format:

```json
{json.dumps(json_data, indent=2)}
```

Your task is to answer the following question based on the report content above:

❓ {user_question}

Please provide a clear and concise answer using bullets or short sentences. Avoid unnecessary commentary.
"""

# --- Run Agent Session ---
def run_query_agent():
    json_data = load_json_report(REPORT_PATH)
    if not json_data:
        return

    print("\n💬 Karate Report Q&A Agent")
    print("Type your questions about the report (e.g., 'How many scenarios failed?') or type 'exit' to quit.")

    while True:
        user_input = input("\n❓ Your question: ").strip()
        if user_input.lower() in {"exit", "quit"}:
            print("👋 Exiting. Goodbye!")
            break

        try:
            prompt = build_prompt(user_input, json_data)
            model = get_model(DEFAULT_MODEL)
            response = model.invoke([HumanMessage(content=prompt)])
            print("\n🤖 Answer:")
            print(response)
        except Exception as e:
            print(f"❌ Error while querying model: {e}")

# --- Entry Point ---
if __name__ == "__main__":
    run_query_agent()
