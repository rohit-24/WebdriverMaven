def extract_cypress_test(file_path: str) -> list[str]:
    step_keywords = ("Given", "When", "Then", "And")
    steps = []

    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            stripped = line.strip()

            # Skip empty lines
            if not stripped:
                continue

            # --- SKIP lines starting with const/import/require
            lowered = stripped.lower()
            if lowered.startswith("const") or lowered.startswith("import") or lowered.startswith("require"):
                continue

            # --- INCLUDE only lines starting with Given/When/Then/And
            if any(stripped.startswith(kw) for kw in step_keywords):
                steps.append(stripped)

    return steps
