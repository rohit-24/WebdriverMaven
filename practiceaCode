Feature TT: Global Search validation

  Scenario Outline: Search client by CIN
    When I search client with CIN <cin>
    Then I should see the client profile

  Examples:
    | cin |
    | placeholder |   # will be replaced dynamically from Excel



import { Before } from "@badeball/cypress-cucumber-preprocessor";

let cinData = [];

// Load CINs before running
Before(() => {
  cy.task('readFieldFromExcel', { market: 'LV_Data', fieldName: 'CIN' })
    .then(cins => {
      cinData = cins;
    });
});

// Provide data-driven test
cinData.forEach(cin => {
  Given(`I search client with CIN ${cin}`, () => {
    cy.get('input[name="documentNumber"]').clear().type(cin);
    cy.get('button').contains('Search').click();
    cy.contains('Client Profile').should('exist');
    cy.screenshot(`SearchResult_${cin}`);
  });
});
