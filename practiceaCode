@SG
Scenario Outline: Global Search validation for multiple CINs
  Given I login to Client Connect using my credentials
  When I search using CIN "<CIN>" in document number field
  Then I should see client profile results

  Examples:
    | CIN |
    | DUMMY |



const market = "SG";

before(() => {
  cy.task('readFieldFromExcel', { market, fieldName: 'CIN' }).then(cins => {
    cins.forEach(cin => {
      // Dynamically add scenario
      Given(`I search using CIN ${cin} in document number field`, function () {
        enterDocumentNumber(cin);
      });
    });
  });
});




on('task', {
  readFieldFromExcel({ market, fieldName }) {
    const filePath = path.resolve('TestData/LV_Data.xlsx');
    const workbook = xlsx.readFile(filePath);
    const sheet = workbook.Sheets[market];
    if (!sheet) {
      throw new Error(`Sheet ${market} not found in Excel file`);
    }

    const jsonData = xlsx.utils.sheet_to_json(sheet);
    if (jsonData.length === 0) {
      throw new Error(`No data found in sheet ${market}`);
    }

    // Return all values of the requested field
    const values = jsonData.map(row => row[fieldName]).filter(v => v !== undefined);

    return values;
  }
});

