import requests
from utils.logger import logger

def get_all_openapi_endpoints(openapi_url):
    try:
        response = requests.get(openapi_url)
        response.raise_for_status()
        spec = response.json()
    except Exception as e:
        logger.error(f"Failed to fetch OpenAPI spec: {e}")
        return set()

    paths = spec.get("paths", {}).keys()
    endpoints = set(paths)

    logger.info(f"[OpenAPI] Total endpoints found: {len(endpoints)}")
    for path in sorted(endpoints):
        logger.debug(f"[OpenAPI]   {path}")

    return endpoints



logger.info("Fetching all OpenAPI endpoints (no context slicing)...")
openapi_endpoints = get_all_openapi_endpoints(openapi_url)

if not openapi_endpoints:
    logger.warning("No OpenAPI endpoints found in the provided spec.")
    return
