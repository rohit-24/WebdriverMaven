const count = await checkbox.count();

for (let i = 0; i < count; i++) {
  const inputHandle = checkbox.nth(i);
  const id = await inputHandle.getAttribute("id");

  if (id) {
    const linkedLabel = page.locator(`label[for="${id}"]`);
    if (await linkedLabel.isVisible()) {
      await linkedLabel.scrollIntoViewIfNeeded();
      await linkedLabel.click();
      console.log(`Checked checkbox with label [${id}]`);
    }
  }
}
