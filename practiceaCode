<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Locator Doctor — Playwright Selector Stability Bench</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #10131a;
    --panel: #161a24;
    --panel-2: #1c212e;
    --line: #2a3040;
    --text: #dfe4ee;
    --muted: #7d8598;
    --accent: #7fd8c4;      /* signal teal */
    --accent-dim: #3c5850;
    --amber: #e8a54b;
    --red: #e8615f;
    --blue: #6ea8fe;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --display: 'Space Grotesk', ui-sans-serif, sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:
      radial-gradient(1200px 600px at 90% -10%, #182034 0%, transparent 60%),
      var(--bg);
    color:var(--text); font-family:var(--mono); line-height:1.5;
    padding:32px 20px 80px;
  }
  .wrap{max-width:1120px; margin:0 auto;}

  header{margin-bottom:28px;}
  .eyebrow{font-family:var(--mono); font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin-bottom:10px; display:flex; align-items:center; gap:8px;}
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--accent); box-shadow:0 0 8px var(--accent);}
  h1{font-family:var(--display); font-weight:700; font-size:clamp(28px,4vw,40px); margin:0 0 8px; letter-spacing:-0.01em;}
  .sub{color:var(--muted); max-width:640px; font-size:14.5px;}

  .grid{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:26px;}
  @media (max-width:820px){.grid{grid-template-columns:1fr;}}

  .panel{background:var(--panel); border:1px solid var(--line); border-radius:10px; overflow:hidden; display:flex; flex-direction:column;}
  .panel-head{display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid var(--line); background:var(--panel-2);}
  .panel-head h2{font-family:var(--display); font-size:13.5px; font-weight:600; margin:0; color:var(--text); text-transform:uppercase; letter-spacing:.06em;}
  .panel-head span{font-size:11.5px; color:var(--muted);}
  textarea{
    width:100%; min-height:230px; resize:vertical; background:transparent; color:var(--text);
    border:none; outline:none; padding:14px 16px; font-family:var(--mono); font-size:13px; tab-size:2;
  }
  textarea::placeholder{color:#4a5164;}

  .controls{display:flex; align-items:center; gap:12px; margin-top:18px; flex-wrap:wrap;}
  button{
    font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer;
    border-radius:7px; border:1px solid var(--line); background:var(--panel-2); color:var(--text);
    padding:10px 16px; transition:border-color .15s, transform .1s, background .15s;
  }
  button:hover{border-color:var(--accent); background:#1d2938;}
  button:active{transform:scale(.98);}
  .primary{background:var(--accent); color:#0b1512; border-color:var(--accent);}
  .primary:hover{background:#8fe2cf; border-color:#8fe2cf;}
  .ghost{background:transparent;}
  .hint{color:var(--muted); font-size:12px;}

  #results{margin-top:34px;}
  .results-head{display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:16px;}
  .results-title{font-family:var(--display); font-size:18px; font-weight:600;}
  .chips{display:flex; gap:8px; flex-wrap:wrap;}
  .chip{
    font-size:11.5px; padding:6px 11px; border-radius:999px; border:1px solid var(--line); color:var(--muted);
    cursor:pointer; user-select:none; background:var(--panel-2);
  }
  .chip.active{color:#0b1512; background:var(--accent); border-color:var(--accent); font-weight:600;}

  .card{
    background:var(--panel); border:1px solid var(--line); border-radius:10px; margin-bottom:12px; overflow:hidden;
  }
  .card-top{display:flex; align-items:center; gap:14px; padding:14px 16px; border-bottom:1px solid var(--line); flex-wrap:wrap;}
  .var-name{font-family:var(--display); font-weight:600; font-size:14.5px; color:var(--text);}
  .badge{
    font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; font-weight:700; padding:3px 9px; border-radius:5px;
  }
  .badge.excellent{color:#0b1512; background:var(--accent);}
  .badge.good{color:#0b1512; background:var(--blue);}
  .badge.fair{color:#221a09; background:var(--amber);}
  .badge.risky{color:#221a09; background:var(--amber);}
  .badge.bad{color:#fff; background:var(--red);}

  .meter{flex:1; min-width:120px; height:6px; border-radius:4px; background:#252b3a; position:relative; overflow:hidden;}
  .meter i{position:absolute; left:0; top:0; bottom:0; border-radius:4px; display:block;}
  .score{font-size:11.5px; color:var(--muted); min-width:34px; text-align:right;}

  .card-body{padding:14px 16px 16px;}
  .row{display:grid; grid-template-columns:90px 1fr; gap:10px; margin-bottom:8px; font-size:12.5px;}
  .row .k{color:var(--muted); text-transform:uppercase; letter-spacing:.06em; font-size:10.5px; padding-top:2px;}
  .code{
    background:var(--panel-2); border:1px solid var(--line); border-radius:6px; padding:8px 10px; font-size:12.8px;
    white-space:pre-wrap; word-break:break-word; color:var(--text);
  }
  .code.suggest{border-color:var(--accent-dim); color:#c9f5ea;}
  .issues{margin:10px 0 0; padding-left:18px; color:var(--amber); font-size:12px;}
  .issues li{margin-bottom:4px;}
  .issues.none{color:var(--muted); list-style:none; padding-left:0;}
  .row-actions{display:flex; justify-content:flex-end; margin-top:10px;}
  .copy-btn{padding:6px 12px; font-size:11.5px;}

  footer{margin-top:40px; color:var(--muted); font-size:12px; border-top:1px solid var(--line); padding-top:16px;}
  .empty{color:var(--muted); font-size:13.5px; padding:30px 0; text-align:center;}
  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px); opacity:0;
    background:var(--accent); color:#0b1512; font-weight:600; font-size:13px; padding:10px 18px; border-radius:8px;
    transition:opacity .2s, transform .2s; pointer-events:none; font-family:var(--mono);
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow"><span class="dot"></span>Locator Doctor</div>
    <h1>Selector stability bench</h1>
    <div class="sub">Paste your page object (or a raw list of locators) on the left, optionally the page's rendered DOM on the right. Every locator gets scored for stability and, where possible, an exact replacement — cross-checked against the real markup, not guessed.</div>
  </header>

  <div class="grid">
    <div class="panel">
      <div class="panel-head">
        <h2>Locators / Page Object</h2>
        <span>.locator · .getByRole · .getByText …</span>
      </div>
      <textarea id="inputCode" placeholder="applicableRulesDropdown = this.page.locator(&quot;#applicableRulesOptions&quot;);
radioButtonConfirm = this.page.locator(&quot;#confirmationOptions_01 > label > span.mat-radio-label-content&quot;);
previewCustomerReference = this.page.locator(&quot;.beneficiaryReference&quot;).first();"></textarea>
    </div>
    <div class="panel">
      <div class="panel-head">
        <h2>Page DOM <span style="color:var(--muted); text-transform:none; font-weight:400;">(optional)</span></h2>
        <span>enables exact suggestions</span>
      </div>
      <textarea id="inputDom" placeholder="Paste the rendered HTML of the page here (View Source / Copy outerHTML on the element or page). Without this, you still get stability scoring and general advice — with it, you get exact getByTestId/getByRole/getByLabel replacements pulled from the real markup."></textarea>
    </div>
  </div>

  <div class="controls">
    <button class="primary" id="analyzeBtn">Analyze locators →</button>
    <button class="ghost" id="loadSample">Load sample</button>
    <button class="ghost" id="clearBtn">Clear</button>
    <span class="hint">Everything runs locally in this page — nothing is sent anywhere.</span>
  </div>

  <div id="results"></div>

  <footer>Scoring model: data-testid / getByTestId highest · id and stable attributes good · text and label locators good · deep CSS chains, nth-child, and framework-generated classes (mat-*, css hashes) penalized.</footer>
</div>

<div class="toast" id="toast">Copied</div>

<script>
const $ = (s, el=document) => el.querySelector(s);
const $$ = (s, el=document) => Array.from(el.querySelectorAll(s));

function showToast(msg){
  const t = $('#toast'); t.textContent = msg || 'Copied';
  t.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(()=>t.classList.remove('show'), 1400);
}

// ---------- Parsing ----------
const METHODS = ['getByTestId','getByRole','getByText','getByLabel','getByPlaceholder','getByTitle','getByAltText','locator'];

function extractCalls(src){
  const results = [];
  const callRegex = /(?:([A-Za-z_$][\w$]*)\s*=\s*)?(?:this\s*\.\s*)?page\s*\.\s*(getByTestId|getByRole|getByText|getByLabel|getByPlaceholder|getByTitle|getByAltText|locator)\s*\(/g;
  let m;
  while ((m = callRegex.exec(src)) !== null){
    const varName = m[1] || null;
    const method = m[2];
    const startParen = callRegex.lastIndex - 1;
    let depth = 0, end = -1;
    for (let i = startParen; i < src.length; i++){
      if (src[i] === '(') depth++;
      else if (src[i] === ')'){ depth--; if (depth === 0){ end = i; break; } }
    }
    if (end === -1) continue;
    const argsRaw = src.slice(startParen+1, end).trim();
    const rest = src.slice(end+1);
    const chainMatch = rest.match(/^\s*\.(first|last)\(\s*\)|^\s*\.nth\(\s*(\d+)\s*\)/);
    const chain = chainMatch ? chainMatch[0].replace(/\s+/g,'') : '';
    results.push({ varName, method, argsRaw, chain });
    callRegex.lastIndex = end + 1;
  }
  if (results.length === 0){
    // Fallback: treat each non-empty line as a raw CSS selector
    src.split('\n').map(l=>l.trim()).filter(Boolean).forEach(line=>{
      const cleaned = line.replace(/;$/,'').replace(/^['"`]|['"`]$/g,'');
      if (cleaned) results.push({ varName:null, method:'locator', argsRaw:`'${cleaned}'`, chain:'' });
    });
  }
  return results;
}

function firstStringArg(argsRaw){
  const m = argsRaw.match(/^['"`]([\s\S]*?)['"`]/);
  return m ? m[1] : argsRaw;
}

// ---------- Scoring ----------
function analyze(call){
  const { method, argsRaw, chain } = call;
  const selectorStr = firstStringArg(argsRaw);
  let score = 60;
  const issues = [];

  if (method === 'getByTestId'){
    score = 98;
  } else if (method === 'getByRole'){
    score = 92;
    if (!/name\s*:/.test(argsRaw)) { score -= 18; issues.push('No accessible "name" option — may match more than one element with this role.'); }
  } else if (['getByLabel','getByPlaceholder','getByAltText','getByTitle'].includes(method)){
    score = 84;
  } else if (method === 'getByText'){
    score = 74;
    issues.push('Text locators break whenever copy changes — fine for stable, non-marketing strings.');
  } else if (method === 'locator'){
    if (/data-testid|data-test-id|data-qa|data-cy/.test(selectorStr)){
      score = 96;
    } else if (/^#[\w-]+$/.test(selectorStr.trim())){
      score = 80;
    } else if (/^\[(aria-label|name|role|title)=/.test(selectorStr.trim())){
      score = 76;
    } else if (/:has-text|:text\(/.test(selectorStr)){
      score = 68;
      issues.push('Playwright text-matching pseudo-class — consider the equivalent getByText() for readability.');
    } else {
      score = 58;
      const chainDepth = (selectorStr.match(/>|\s(?=[.#\[a-zA-Z])/g) || []).length;
      if (chainDepth > 0){
        score -= chainDepth * 9;
        issues.push(`Selector reaches ${chainDepth + 1} level${chainDepth>0?'s':''} deep (uses combinators) — breaks if any intermediate element changes.`);
      }
      if (/:nth-child|:nth-of-type/.test(selectorStr)){
        score -= 25;
        issues.push('Positional selector (nth-child / nth-of-type) — breaks the moment sibling order or count changes.');
      }
      if (/\bmat-[\w-]+\b/.test(selectorStr)){
        score -= 12;
        issues.push('Targets an Angular Material internal class (mat-*) — an implementation detail the library can change on upgrade.');
      }
      if (/\b[a-z0-9]+-[0-9a-f]{5,}\b/.test(selectorStr) || /\bcss-[a-z0-9]+\b/.test(selectorStr)){
        score -= 20;
        issues.push('Looks like a generated/hashed class name (CSS-in-JS or build output) — will change on the next rebuild.');
      }
    }
  }

  if (/^\.first\(\)/.test(chain)){
    score -= 10;
    issues.push('Uses .first() — a sign the selector is ambiguous (matches multiple elements). Narrowing the selector is usually better than truncating the list.');
  }
  if (/^\.nth\(/.test(chain)){
    score -= 15;
    issues.push('Uses .nth(n) — positional and will silently point at the wrong element if the list reorders.');
  }

  score = Math.max(2, Math.min(100, Math.round(score)));
  let category;
  if (score >= 90) category = 'excellent';
  else if (score >= 75) category = 'good';
  else if (score >= 55) category = 'fair';
  else if (score >= 35) category = 'risky';
  else category = 'bad';

  return { score, category, issues, selectorStr };
}

// ---------- DOM cross-check ----------
function buildDoc(domText){
  if (!domText || !domText.trim()) return null;
  try{
    const parser = new DOMParser();
    const doc = parser.parseFromString(domText, 'text/html');
    return doc;
  } catch(e){ return null; }
}

function guessRole(el){
  const tag = el.tagName.toLowerCase();
  const type = (el.getAttribute('type')||'').toLowerCase();
  if (el.getAttribute('role')) return el.getAttribute('role');
  if (tag === 'button') return 'button';
  if (tag === 'a' && el.hasAttribute('href')) return 'link';
  if (tag === 'input'){
    if (type === 'radio') return 'radio';
    if (type === 'checkbox') return 'checkbox';
    if (type === 'button' || type === 'submit') return 'button';
    return 'textbox';
  }
  if (tag === 'select') return 'combobox';
  if (tag === 'textarea') return 'textbox';
  return null;
}

function accessibleName(el, doc){
  const aria = el.getAttribute('aria-label');
  if (aria) return aria.trim();
  if (el.id){
    const lbl = doc.querySelector(`label[for="${CSS.escape(el.id)}"]`);
    if (lbl && lbl.textContent.trim()) return lbl.textContent.trim();
  }
  const text = el.textContent && el.textContent.trim();
  if (text && text.length <= 60) return text;
  return null;
}

function domSuggestion(doc, selectorStr){
  if (!doc || !selectorStr) return null;
  let el = null;
  try { el = doc.querySelector(selectorStr); } catch(e){ return { notFound:true, error:true }; }
  if (!el) return { notFound:true };

  const testid = el.getAttribute('data-testid') || el.getAttribute('data-test-id') || el.getAttribute('data-qa') || el.getAttribute('data-cy');
  const role = guessRole(el);
  const name = accessibleName(el, doc);
  const ariaLabel = el.getAttribute('aria-label');
  const nameAttr = el.getAttribute('name');
  const id = el.id;

  if (testid) return { method:'getByTestId', arg:testid, code: `page.getByTestId('${esc(testid)}')`, why: 'Element (or the correct target) carries a data-testid in the real DOM — the most stable option available.' };
  if (role && name) return { method:'getByRole', arg:name, role, code: `page.getByRole('${role}', { name: '${esc(name)}' })`, why: `Matched element has role "${role}" and an accessible name in the DOM — mirrors how a user/screen-reader finds it.` };
  if (ariaLabel) return { method:'getByLabel', arg:ariaLabel, code: `page.getByLabel('${esc(ariaLabel)}')`, why: 'Element has an aria-label in the DOM.' };
  if (id && /^[a-zA-Z][\w-]*$/.test(id) && !/^[a-f0-9]{6,}$/i.test(id)) return { method:'locator', arg:`#${id}`, code: `page.locator('#${id}')`, why: 'Element itself has a semantic, human-readable id — simpler and just as stable as the current chain.' };
  if (nameAttr) return { method:'locator', arg:`[name="${nameAttr}"]`, code: `page.locator('[name="${nameAttr}"]')`, why: 'Element has a stable name attribute in the DOM.' };
  return { code: null, why: 'No data-testid, aria-label, role+name, or stable id found on this element in the provided DOM — worth adding a data-testid here.' };
}

function esc(s){ return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }

// Build a self-contained Chrome DevTools console snippet that mimics a Playwright
// locator strategy against the live DOM, logs the match count, and highlights matches.
function devtoolsSnippet(method, arg, opts){
  opts = opts || {};
  const HI = "el.style.outline='3px solid #7fd8c4'; el.style.outlineOffset='2px';";
  const argJson = JSON.stringify(arg == null ? '' : arg);
  switch(method){
    case 'getByTestId':
      return `(() => { const els=[...document.querySelectorAll('[data-testid="${esc(arg)}"],[data-test-id="${esc(arg)}"],[data-qa="${esc(arg)}"],[data-cy="${esc(arg)}"]')]; console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    case 'locator':
      return `(() => { const els=[...document.querySelectorAll('${arg.replace(/\\/g,'\\\\').replace(/'/g,"\\'")}')]; console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    case 'getByRole': {
      const roleMap = {
        button: 'button, [role="button"], input[type="submit"], input[type="button"]',
        link: 'a[href], [role="link"]',
        radio: 'input[type="radio"], [role="radio"]',
        checkbox: 'input[type="checkbox"], [role="checkbox"]',
        textbox: 'input, textarea, [role="textbox"]',
        combobox: 'select, [role="combobox"]'
      };
      const sel = roleMap[opts.role] || `[role="${opts.role || ''}"]`;
      return `(() => { const name=${argJson}; const els=[...document.querySelectorAll('${sel}')].filter(el => (el.getAttribute('aria-label')||el.textContent||'').trim().includes(name)); console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    }
    case 'getByText':
      return `(() => { const target=${argJson}; const els=[...document.querySelectorAll('body *')].filter(el => el.children.length===0 && el.textContent.trim() === target); console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    case 'getByLabel':
      return `(() => { const target=${argJson}; const lbl=[...document.querySelectorAll('label')].find(l=>l.textContent.trim()===target); const input = lbl ? (lbl.control || (lbl.getAttribute('for') && document.getElementById(lbl.getAttribute('for')))) : document.querySelector('[aria-label="'+target+'"]'); console.log(input ? 'Match found' : 'No match'); if(input){ input.style.outline='3px solid #7fd8c4'; input.style.outlineOffset='2px'; } return input; })();`;
    case 'getByPlaceholder':
      return `(() => { const els=[...document.querySelectorAll('[placeholder="${esc(arg)}"]')]; console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    case 'getByTitle':
      return `(() => { const els=[...document.querySelectorAll('[title="${esc(arg)}"]')]; console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    case 'getByAltText':
      return `(() => { const els=[...document.querySelectorAll('[alt="${esc(arg)}"]')]; console.log('Matches:', els.length); els.forEach(el=>{${HI}}); return els; })();`;
    default:
      return `document.querySelectorAll('${String(arg).replace(/'/g,"\\'")}')`;
  }
}

// Pull role + accessible-name option out of a getByRole(...) call's raw args, e.g. "'radio', { name: 'Confirm' }"
function parseRoleArgs(argsRaw){
  const roleMatch = argsRaw.match(/^['"`]([\s\S]*?)['"`]/);
  const nameMatch = argsRaw.match(/name\s*:\s*['"`]([\s\S]*?)['"`]/);
  return { role: roleMatch ? roleMatch[1] : null, name: nameMatch ? nameMatch[1] : '' };
}

// ---------- Rendering ----------
let lastCards = [];

function colorFor(category){
  return { excellent:'var(--accent)', good:'var(--blue)', fair:'var(--amber)', risky:'var(--amber)', bad:'var(--red)' }[category];
}

function renderResults(cards){
  const wrap = $('#results');
  if (cards.length === 0){
    wrap.innerHTML = '<div class="empty">Paste some locators above and hit Analyze.</div>';
    return;
  }
  const counts = cards.reduce((acc,c)=>{acc[c.category]=(acc[c.category]||0)+1; return acc;}, {});
  const chipDefs = ['all','excellent','good','fair','risky','bad'];

  wrap.innerHTML = `
    <div class="results-head">
      <div class="results-title">${cards.length} locator${cards.length!==1?'s':''} analyzed</div>
      <div class="chips">${chipDefs.map(c=>`<div class="chip ${c==='all'?'active':''}" data-filter="${c}">${c}${c!=='all'?` (${counts[c]||0})`:''}</div>`).join('')}</div>
      <button class="primary" id="copyAllBtn">Copy all suggested code</button>
    </div>
    <div id="cardList"></div>
  `;

  const list = $('#cardList');
  list.innerHTML = cards.map((c, idx) => `
    <div class="card" data-category="${c.category}">
      <div class="card-top">
        <div class="var-name">${c.varName ? c.varName : '(unnamed)'}</div>
        <div class="badge ${c.category}">${c.category}</div>
        <div class="meter"><i style="width:${c.score}%; background:${colorFor(c.category)}"></i></div>
        <div class="score">${c.score}/100</div>
      </div>
      <div class="card-body">
        <div class="row"><div class="k">Current</div><div class="code">${escapeHtml(c.originalCode)}</div></div>
        ${c.suggestion && c.suggestion.code ? `
        <div class="row"><div class="k">Suggest</div><div class="code suggest">${escapeHtml(buildAssignment(c.varName, c.suggestion.code))}</div></div>
        ` : ''}
        ${c.suggestion && c.suggestion.why ? `<div class="row"><div class="k">Because</div><div style="font-size:12px;color:var(--muted);padding-top:4px;">${escapeHtml(c.suggestion.why)}</div></div>` : ''}
        ${c.issues.length ? `<ul class="issues">${c.issues.map(i=>`<li>${escapeHtml(i)}</li>`).join('')}</ul>` : `<ul class="issues none">No structural red flags detected.</ul>`}

        <div class="row"><div class="k">Test now</div><div class="code" style="color:#a9b3c9;">${escapeHtml(c.devtoolsCurrent)}</div></div>
        ${c.devtoolsSuggested ? `<div class="row"><div class="k">Test fix</div><div class="code suggest">${escapeHtml(c.devtoolsSuggested)}</div></div>` : ''}
        <div style="font-size:11px;color:var(--muted); margin:2px 0 0;">Paste into Chrome DevTools → Console on the live page. Logs a match count and outlines whatever it finds.</div>

        <div class="row-actions">
          <button class="copy-btn" data-kind="pw" data-idx="${idx}">Copy Playwright line</button>
          <button class="copy-btn" data-kind="dt-current" data-idx="${idx}">Copy DevTools (current)</button>
          ${c.devtoolsSuggested ? `<button class="copy-btn" data-kind="dt-suggest" data-idx="${idx}">Copy DevTools (fix)</button>` : ''}
        </div>
      </div>
    </div>
  `).join('');

  $$('.copy-btn', list).forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const c = cards[btn.dataset.idx];
      const kind = btn.dataset.kind;
      let text, label;
      if (kind === 'pw'){
        text = buildAssignment(c.varName, (c.suggestion && c.suggestion.code) ? c.suggestion.code : c.originalCode.replace(/^[^=]*=\s*/,''));
        label = 'Playwright line copied';
      } else if (kind === 'dt-current'){
        text = c.devtoolsCurrent;
        label = 'DevTools snippet copied';
      } else {
        text = c.devtoolsSuggested;
        label = 'DevTools snippet copied';
      }
      navigator.clipboard.writeText(text).then(()=>showToast(label));
    });
  });

  $$('.chip', wrap).forEach(chip=>{
    chip.addEventListener('click', ()=>{
      $$('.chip', wrap).forEach(c=>c.classList.remove('active'));
      chip.classList.add('active');
      const f = chip.dataset.filter;
      $$('.card', list).forEach(card=>{
        card.style.display = (f==='all' || card.dataset.category===f) ? '' : 'none';
      });
    });
  });

  $('#copyAllBtn').addEventListener('click', ()=>{
    const text = cards.map(c=>{
      const code = (c.suggestion && c.suggestion.code) ? c.suggestion.code : c.originalCode.replace(/^[^=]*=\s*/,'');
      const line = buildAssignment(c.varName, code);
      const flag = c.category === 'excellent' || c.category === 'good' ? '' : `  // ${c.category} — ${c.issues[0] || 'review'}`;
      return line + (flag ? ';' + flag : ';');
    }).join('\n');
    navigator.clipboard.writeText(text).then(()=>showToast('All lines copied'));
  });
}

function buildAssignment(varName, code){
  return varName ? `${varName} = this.${code};` : `this.${code};`;
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function reconstructOriginal(call){
  const prefix = call.varName ? `${call.varName} = this.page.` : `this.page.`;
  return `${prefix}${call.method}(${call.argsRaw})${call.chain}`;
}

// ---------- Wire up ----------
$('#analyzeBtn').addEventListener('click', ()=>{
  const code = $('#inputCode').value;
  const domText = $('#inputDom').value;
  const doc = buildDoc(domText);

  const calls = extractCalls(code);
  const cards = calls.map(call=>{
    const { score, category, issues, selectorStr } = analyze(call);
    let suggestion = null;
    if (call.method === 'locator'){
      const ds = doc ? domSuggestion(doc, selectorStr) : null;
      if (ds && ds.code) suggestion = { code: ds.code, why: ds.why, method: ds.method, arg: ds.arg, role: ds.role };
      else if (ds && ds.notFound && doc) issues.push(ds.error ? "Selector couldn't be evaluated as plain CSS (uses a Playwright-only pseudo-class) — copy the exact suggestion manually." : 'No element in the pasted DOM matched this selector — verify it still applies to the current page.');
    }

    // DevTools snippet for the locator as it exists today
    let devtoolsCurrent;
    if (call.method === 'getByRole'){
      const { role, name } = parseRoleArgs(call.argsRaw);
      devtoolsCurrent = devtoolsSnippet('getByRole', name, { role });
    } else {
      devtoolsCurrent = devtoolsSnippet(call.method, selectorStr);
    }

    // DevTools snippet for the suggested replacement, if one exists
    let devtoolsSuggested = null;
    if (suggestion && suggestion.method){
      devtoolsSuggested = devtoolsSnippet(suggestion.method, suggestion.arg, { role: suggestion.role });
    }

    return {
      varName: call.varName,
      originalCode: reconstructOriginal(call),
      score, category, issues, suggestion,
      devtoolsCurrent, devtoolsSuggested
    };
  });

  cards.sort((a,b)=> a.score - b.score);
  lastCards = cards;
  renderResults(cards);
  document.getElementById('results').scrollIntoView({behavior:'smooth', block:'start'});
});

$('#clearBtn').addEventListener('click', ()=>{
  $('#inputCode').value = '';
  $('#inputDom').value = '';
  lastCards = [];
  renderResults([]);
});

