def extract_cypress_test(file_path: str) -> list[str]:
    step_keywords = ("Given", "When", "Then", "And")
    steps = []

    inside_import_block = False

    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            stripped = line.strip()

            if not stripped:
                continue

            # Start of multi-line import block
            if stripped.startswith("const {") or stripped.startswith("import {"):
                inside_import_block = True
                continue

            # End of multi-line import block
            if inside_import_block:
                if "}" in stripped:
                    inside_import_block = False
                    continue  # ⚠️ Problem: this skips processing the line with "}"
                else:
                    continue

            # Skip single-line import/require
            lowered = stripped.lower()
            if lowered.startswith("import") or lowered.startswith("require") or lowered.startswith("const"):
                if "require(" in lowered or "from" in lowered:
                    continue

            # Capture steps like Given/When/Then/And
            if any(stripped.startswith(kw) for kw in step_keywords):
                steps.append(stripped)

    return steps
