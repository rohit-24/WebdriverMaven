## NEW — `src/checks/middlewareHealthCheck.js`

```js
const { test, expect } = require('@playwright/test');
const WasConsolePage = require('../pages/middleware/WasConsolePage');
const logger = require('../core/logger');

/**
 * middlewareHealthCheck.js
 * ------------------------------------------------------------------
 * Phase 3 - WAS console login + "all servers green" verification.
 * Signature mirrors uiHealthCheck.js: run(page, target, credentials).
 * Credentials are resolved by the spec (via secretsProvider), so this
 * file stays free of any secrets-lookup logic.
 *
 * No JVM names/counts are hardcoded per app - see WasConsolePage.js
 * for the generic row-scan design. Only a minimum-row-count guard
 * (target.middleware.minExpectedServers) protects against a silently
 * empty/broken page reporting a false PASS.
 * ------------------------------------------------------------------
 */
async function runMiddlewareHealthCheck(page, target, credentials) {
  const was = new WasConsolePage(page, target);
  const scope = `${target.appId}/${target.env}/middleware`;

  await test.step('Navigate to WAS console login page', async () => {
    await page.goto(target.wasConsoleUrl, { waitUntil: 'domcontentloaded' });
  });

  await test.step('Login to WAS console', async () => {
    await was.login(credentials);
  });

  await test.step('Verify middleware servers are running', async () => {
    const statuses = await was.getAllServerStatuses();
    logger.info(scope, `Servers found: ${JSON.stringify(statuses)}`);

    const minExpected = target.middleware.minExpectedServers ?? 1;
    expect(
      statuses.length,
      `Expected at least ${minExpected} server row(s), found ${statuses.length} - page may not have loaded correctly`
    ).toBeGreaterThanOrEqual(minExpected);

    const down = statuses.filter((s) => s.status !== 'RUNNING');
    expect(
      down,
      `Server(s) not running: ${down.map((s) => `${s.name} (${s.reason})`).join(', ') || 'none'}`
    ).toHaveLength(0);
  });
}

module.exports = { runMiddlewareHealthCheck };
```

