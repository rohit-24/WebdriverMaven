from config.config import INPUT_FILE, OUTPUT_DIR
from python_scripts.file_parser import extract_cypress_test
from python_scripts.playwright_generator import generate_playwright_files
from prompts.migration_prompt_template import get_prompt
from models.model_factory import get_model
from utils.get_token import get_token

def main():
    token = get_token()
    model = get_model("claude", token)  # change to "gemini" if needed

    # Step 1: Read Cypress test file
    cypress_test = extract_cypress_test(INPUT_FILE)

    # Step 2: Generate prompt
    prompt = get_prompt(cypress_test)

    # Step 3: Call Claude/Gemini
    response = model.call(prompt)

    # Step 4: Save .ts files to output folder
    generate_playwright_files(response, OUTPUT_DIR)

if __name__ == "__main__":
    main()
