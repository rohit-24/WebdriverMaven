    <span class="mat-radio-label-content">Confirm</span>
  </label>
  <input type="radio" id="mat-radio-3-input" name="confirmationOptions" data-testid="confirmation-confirm">
</div>
<button id="next" data-testid="wizard-next-button">Next</button>
<input id="irv_flag-input" type="checkbox" aria-label="Irrevocable" data-testid="irrevocable-checkbox">`;
  showToast('Sample loaded');
});

renderResults([]);
</script>
