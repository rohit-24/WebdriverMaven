def generate_playwright_files(page_obj_code: str, step_def_code: str, output_dir: str):
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "refactored.page.ts"), "w", encoding="utf-8") as f1:
        f1.write(page_obj_code)

    with open(os.path.join(output_dir, "refactored.step.ts"), "w", encoding="utf-8") as f2:
        f2.write(step_def_code)
