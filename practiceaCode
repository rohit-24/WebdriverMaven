import { ChatAnthropic } from "@langchain/anthropic";
import { tool } from "@langchain/core/tools";
import { z } from "zod";

// Use the built-in ChatAnthropic but point it to your endpoint
const model = new ChatAnthropic({
  apiKey: process.env.OFFICE_API_TOKEN!,
  model: "claude-3-5-sonnet@20240620",
  // Override the base URL to use your custom endpoint
  clientOptions: {
    baseURL: "https://stork.apps.ocp8.uat.xyz.com/v1/projects/xyz-mod-adag-d4q9v/locations/asia-southeast1/publishers/anthropic/models"
  }
});

const getWeatherTool = tool(
  async (input) => `It's sunny in ${input.city}!`,
  {
    name: "get_weather",
    description: "Get the weather for a given city",
    schema: z.object({
      city: z.string().describe("The city to get the weather for"),
    }),
  }
);

// Now it's simple again!
const agent = createReactAgent({
  llm: model,
  tools: [getWeatherTool],
});

const result = await agent.invoke({
  messages: [{ role: "user", content: "What's the weather in Tokyo?" }],
});
