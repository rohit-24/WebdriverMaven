export class LoansPage {
  constructor(private page: Page) {}

  async openTab(tabName: string) {
    await this.page.getByRole("tab", { name: tabName }).click();
  }

  async openThreeDotMenu() {
    await this.page
      .locator('[data-testid="loan-options"]')
      .first()
      .click();
  }

  async getVisibleActions(): Promise<string[]> {
    const actions = await this.page
      .locator('[data-testid^="dropdown-menu-item"]')
      .allTextContents();

    return actions.map(a => a.trim());
  }

  async verifyLoanActions(rules: { Tab: string; Actions: string }[]) {
    for (const rule of rules) {
      await this.openTab(rule.Tab);
      await this.openThreeDotMenu();

      const expectedActions = rule.Actions.split(",").map(a => a.trim());
      const actualActions = await this.getVisibleActions();

      expect(actualActions).toEqual(expect.arrayContaining(expectedActions));
      expect(actualActions.length).toBe(expectedActions.length);
    }
  }
}

Then(
  "I should see the following actions in loan options menu",
  async function (dataTable) {
    const expectedRules = dataTable.hashes();
    await loansPage.verifyLoanActions(expectedRules);
  }
);

