Cypress.Commands.add('scrollToBottomUntilNoMoreContent', (waitTime = 1000) => {
  let previousHeight = 0;

  function scroll() {
    cy.document().then((doc) => {
      const el = doc.documentElement;
      const currentHeight = el.scrollHeight;
      const clientHeight = el.clientHeight;

      // 🚫 Page is not scrollable
      if (currentHeight <= clientHeight) {
        Cypress.log({ name: 'scroll', message: 'Page is not scrollable — exiting.' });
        return;
      }

      // ✅ Continue scrolling if new content is loaded
      if (currentHeight > previousHeight) {
        previousHeight = currentHeight;
        cy.scrollTo('bottom');
        cy.wait(waitTime).then(() => scroll());
      } else {
        Cypress.log({ name: 'scroll', message: 'No more content to scroll — done.' });
      }
    });
  }

  scroll();
});
