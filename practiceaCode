

const axios = require('axios');

// 🔧 Replace with your actual details
const BASE_URL = 'https://your-api-endpoint.com/api/cases'; // API endpoint
const TARGET_CASE_ID = 'PFSG-800020870'; // Case ID to search
const BEARER_TOKEN = 'YOUR_BEARER_TOKEN_HERE'; // Token
const PAGE_SIZE = 50; // adjust based on your API

async function findCasePage() {
  try {
    // 1️⃣ Fetch first page to get total pages
    const firstPayload = { pageNum: 1, pageSize: PAGE_SIZE };
    const firstResponse = await axios.post(BASE_URL, firstPayload, {
      headers: { Authorization: `Bearer ${BEARER_TOKEN}` },
    });

    const totalPages = firstResponse.data.data.totalPages;
    console.log(`Total Pages: ${totalPages}`);

    // 2️⃣ Loop through all pages
    for (let page = 1; page <= totalPages; page++) {
      console.log(`🔎 Checking page ${page}...`);
      const payload = { pageNum: page, pageSize: PAGE_SIZE };

      const response = await axios.post(BASE_URL, payload, {
        headers: { Authorization: `Bearer ${BEARER_TOKEN}` },
      });

      const cases = response.data.data.onGoingCase;
      const found = cases.find(c => c.caseId === TARGET_CASE_ID);

      if (found) {
        console.log(`✅ Found Case ID "${TARGET_CASE_ID}" on Page ${page}`);
        console.log(found);
        return;
      }
    }

    console.log(`❌ Case ID "${TARGET_CASE_ID}" not found in any page.`);
  } catch (error) {
    console.error('⚠️ Error fetching data:', error.response?.data || error.message);
  }
}

findCasePage();
