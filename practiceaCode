radioButtonConfirm = this.page.locator("#confirmationOptions_01 > label > span.mat-radio-label-content");
radioButtonMayAdd = this.page.locator("#confirmationOptions_02 > label > span.mat-radio-label-content");
radioButtonWithout = this.page.locator("#confirmationOptions_03 > label > span.mat-radio-label-content");
previewCustomerReference = this.page.locator(".beneficiaryReference").first();
previewDraweeReference = this.page.locator(".customerReference").first();
generalDetailsTab = this.page.locator("#generalDetails-0");
applicantAndBeneficiaryTab = this.page.locator("#applicantBeneficiaryDetails-1");
modeOfTransmissionSwift = this.page.locator("#transmissionModeSWIFT-button");
nextBtn = this.page.locator("#next");
expiryDate = this.page.locator("#expiryDate");
placeOfExpiryAtAdvising = this.page.locator("#placeOfExpiry-panel > mat-option:nth-child(1)");
irrevocableCheckbox = this.page.locator("#irv_flag-input");`;

