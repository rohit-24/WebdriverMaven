import pandas as pd
import numpy as np
import time


# ============================================================
# CONFIGURATION
# ============================================================

SOURCE_FILE = "source.xlsx"
TARGET_FILE = "target.xlsx"

OUTPUT_FILE = "reconciliation_result.xlsx"

# IMPORTANT:
# Put the column which identifies a record here.
UNIQUE_ID_COLUMN = "UNIQUE"

# Columns that should NOT be compared.
# Leave empty if all common columns should be compared.
IGNORE_COLUMNS = [
    # "Last_Updated_Time",
    # "System_Timestamp",
]

# Numeric tolerance.
#
# Example:
# 37.21999999999999 vs 37.22
#
# Difference is tiny and will be considered equal.
NUMERIC_TOLERANCE = 0.000001


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def clean_text(value):
    """
    Clean text values.
    """

    if pd.isna(value):
        return None

    value = str(value).strip()

    if value == "":
        return None

    return value


def is_numeric(value):
    """
    Check whether a value can be interpreted as a number.
    """

    if value is None or pd.isna(value):
        return False

    try:
        float(value)
        return True
    except (ValueError, TypeError):
        return False


def normalize_identifier(value):
    """
    Normalize ID values.

    Examples:

    7112936335
    7112936335.0
    7.112936335E9

    will be treated consistently.

    IMPORTANT:
    We keep identifiers as text rather than converting
    them to floating-point numbers.
    """

    if pd.isna(value):
        return None

    text = str(value).strip()

    if text == "":
        return None

    # If Excel/Pandas has represented an integer as 123.0
    # convert it to 123.
    try:

        number = float(text)

        if number.is_integer():

            return str(int(number))

    except (ValueError, TypeError):

        pass

    return text


def values_equal(source_value, target_value):
    """
    Compare two values intelligently.

    Handles:

    1. Empty vs empty
    2. Number vs number
    3. Numeric text vs number
    4. Floating-point precision
    5. Text spaces/case
    """

    # --------------------------------------------------------
    # Both empty
    # --------------------------------------------------------

    if pd.isna(source_value) and pd.isna(target_value):
        return True

    # One empty, one not empty
    if pd.isna(source_value) or pd.isna(target_value):
        return False

    source_text = str(source_value).strip()
    target_text = str(target_value).strip()

    # Empty strings
    if source_text == "" and target_text == "":
        return True

    # --------------------------------------------------------
    # Numeric comparison
    # --------------------------------------------------------

    if is_numeric(source_value) and is_numeric(target_value):

        try:

            source_number = float(source_value)
            target_number = float(target_value)

            return np.isclose(
                source_number,
                target_number,
                atol=NUMERIC_TOLERANCE,
                rtol=0
            )

        except (ValueError, TypeError):

            pass

    # --------------------------------------------------------
    # Text comparison
    # --------------------------------------------------------

    return source_text.lower() == target_text.lower()


# ============================================================
# START
# ============================================================

start_time = time.time()

print()
print("==============================================")
print("       EXCEL RECONCILIATION STARTED")
print("==============================================")


# ============================================================
# READ EXCEL
# ============================================================

print()
print("Reading source file...")

source = pd.read_excel(
    SOURCE_FILE,
    dtype=object
)

print("Reading target file...")

target = pd.read_excel(
    TARGET_FILE,
    dtype=object
)

print()
print(f"Source rows : {len(source):,}")
print(f"Target rows : {len(target):,}")


# ============================================================
# CLEAN COLUMN NAMES
# ============================================================

source.columns = (
    source.columns
    .astype(str)
    .str.strip()
)

target.columns = (
    target.columns
    .astype(str)
    .str.strip()
)


# ============================================================
# VALIDATE ID COLUMN
# ============================================================

if UNIQUE_ID_COLUMN not in source.columns:

    raise ValueError(
        f"'{UNIQUE_ID_COLUMN}' not found in SOURCE."
    )


if UNIQUE_ID_COLUMN not in target.columns:

    raise ValueError(
        f"'{UNIQUE_ID_COLUMN}' not found in TARGET."
    )


# ============================================================
# NORMALIZE ID
# ============================================================

source["_COMPARE_ID"] = (
    source[UNIQUE_ID_COLUMN]
    .apply(normalize_identifier)
)

target["_COMPARE_ID"] = (
    target[UNIQUE_ID_COLUMN]
    .apply(normalize_identifier)
)


# ============================================================
# CHECK DUPLICATE IDs
# ============================================================

source_duplicate_rows = source[
    source["_COMPARE_ID"].duplicated(keep=False)
].copy()

target_duplicate_rows = target[
    target["_COMPARE_ID"].duplicated(keep=False)
].copy()


print()
print("==============================================")
print("DUPLICATE ID CHECK")
print("==============================================")

print(
    f"Source duplicate rows : "
    f"{len(source_duplicate_rows):,}"
)

print(
    f"Target duplicate rows : "
    f"{len(target_duplicate_rows):,}"
)


# ============================================================
# STOP IF ID IS NOT UNIQUE
# ============================================================

if not source_duplicate_rows.empty:

    print()
    print(
        "WARNING: Source ID is NOT UNIQUE."
    )

    print(
        "A simple ID-based merge could create "
        "incorrect many-to-many matches."
    )


if not target_duplicate_rows.empty:

    print()
    print(
        "WARNING: Target ID is NOT UNIQUE."
    )


# ============================================================
# FIND COMMON COLUMNS
# ============================================================

source_columns = set(source.columns)
target_columns = set(target.columns)

common_columns = (
    source_columns & target_columns
)

# Remove internal column
common_columns.discard("_COMPARE_ID")

# Remove unique ID
common_columns.discard(UNIQUE_ID_COLUMN)

# Remove ignored columns
compare_columns = [
    column
    for column in common_columns
    if column not in IGNORE_COLUMNS
]

compare_columns = sorted(compare_columns)


print()
print("==============================================")
print("COLUMN ANALYSIS")
print("==============================================")

print(
    f"Columns being compared : "
    f"{len(compare_columns)}"
)

print(
    f"Columns ignored        : "
    f"{len(IGNORE_COLUMNS)}"
)


# ============================================================
# IF IDS ARE UNIQUE
# ============================================================

source_ids_unique = (
    not source["_COMPARE_ID"].duplicated().any()
)

target_ids_unique = (
    not target["_COMPARE_ID"].duplicated().any()
)


# ============================================================
# UNIQUE-ID RECONCILIATION
# ============================================================

if source_ids_unique and target_ids_unique:

    print()
    print("IDs are unique in both files.")
    print("Performing normal reconciliation...")

    merged = pd.merge(
        source,
        target,
        on="_COMPARE_ID",
        how="outer",
        suffixes=("_source", "_target"),
        indicator=True,
        validate="one_to_one"
    )

    # --------------------------------------------------------
    # Missing
    # --------------------------------------------------------

    missing_in_target = merged[
        merged["_merge"] == "left_only"
    ].copy()

    # --------------------------------------------------------
    # Extra
    # --------------------------------------------------------

    extra_in_target = merged[
        merged["_merge"] == "right_only"
    ].copy()

    # --------------------------------------------------------
    # Both
    # --------------------------------------------------------

    both = merged[
        merged["_merge"] == "both"
    ].copy()


# ============================================================
# DUPLICATE IDS
# ============================================================

else:

    print()
    print("==============================================")
    print("DUPLICATE IDS DETECTED")
    print("==============================================")

    print()
    print(
        "The program will NOT perform a many-to-many merge."
    )

    print(
        "Please identify a true unique key or "
        "a composite key."
    )

    # Create duplicate report

    duplicate_source = (
        source_duplicate_rows
        .drop(columns=["_COMPARE_ID"])
    )

    duplicate_target = (
        target_duplicate_rows
        .drop(columns=["_COMPARE_ID"])
    )

    # Create a partial report

    with pd.ExcelWriter(
        OUTPUT_FILE,
        engine="openpyxl"
    ) as writer:

        duplicate_source.to_excel(
            writer,
            sheet_name="Duplicate_Source_IDs",
            index=False
        )

        duplicate_target.to_excel(
            writer,
            sheet_name="Duplicate_Target_IDs",
            index=False
        )

        pd.DataFrame({
            "Message": [
                "Unique ID is not unique in source or target.",
                "Reconciliation was NOT performed.",
                "Please identify a true unique key or composite key."
            ]
        }).to_excel(
            writer,
            sheet_name="Summary",
            index=False
        )

    print()
    print(
        f"Duplicate report generated: "
        f"{OUTPUT_FILE}"
    )

    print()
    print(
        "IMPORTANT: Do not use the previous "
        "427K mismatch result."
    )

    raise SystemExit


# ============================================================
# COMPARE COLUMNS
# ============================================================

print()
print("Comparing values...")

mismatch_records = []

for column in compare_columns:

    source_column = f"{column}_source"
    target_column = f"{column}_target"

    for _, row in both.iterrows():

        source_value = row[source_column]
        target_value = row[target_column]

        if not values_equal(
            source_value,
            target_value
        ):

            mismatch_records.append({

                UNIQUE_ID_COLUMN:
                    row["_COMPARE_ID"],

                "Column":
                    column,

                "Source_Value":
                    source_value,

                "Target_Value":
                    target_value

            })


# ============================================================
# MISMATCH DATAFRAME
# ============================================================

if mismatch_records:

    mismatches = pd.DataFrame(
        mismatch_records
    )

else:

    mismatches = pd.DataFrame(
        columns=[
            UNIQUE_ID_COLUMN,
            "Column",
            "Source_Value",
            "Target_Value"
        ]
    )


# ============================================================
# MISMATCH IDS
# ============================================================

mismatched_ids = set(
    mismatches[UNIQUE_ID_COLUMN]
)

both_ids = set(
    both["_COMPARE_ID"]
)

exact_match_ids = (
    both_ids - mismatched_ids
)


# ============================================================
# ALL RESULTS
# ============================================================

all_results = pd.DataFrame({
    UNIQUE_ID_COLUMN:
        list(both_ids)
})

all_results["Result"] = (
    all_results[
        UNIQUE_ID_COLUMN
    ].apply(
        lambda x:
        "MISMATCH"
        if x in mismatched_ids
        else "MATCH"
    )
)


# ============================================================
# MISSING / EXTRA
# ============================================================

missing_output = (
    missing_in_target[
        [UNIQUE_ID_COLUMN]
    ]
    .copy()
)

extra_output = (
    extra_in_target[
        [UNIQUE_ID_COLUMN]
    ]
    .copy()
)


# ============================================================
# SUMMARY
# ============================================================

summary = pd.DataFrame({

    "Metric": [

        "Source Records",

        "Target Records",

        "Records Present In Both",

        "Exact Matches",

        "Records With Mismatch",

        "Missing In Target",

        "Extra In Target",

        "Columns Compared"

    ],

    "Count": [

        len(source),

        len(target),

        len(both),

        len(exact_match_ids),

        len(mismatched_ids),

        len(missing_in_target),

        len(extra_in_target),

        len(compare_columns)

    ]

})


# ============================================================
# COLUMN SUMMARY
# ============================================================

column_summary = pd.DataFrame({

    "Column":
        compare_columns,

    "Mismatch_Count": [

        (
            mismatches["Column"] == column
        ).sum()

        for column in compare_columns

    ]

})

column_summary = (
    column_summary
    .sort_values(
        "Mismatch_Count",
        ascending=False
    )
)


# ============================================================
# WRITE REPORT
# ============================================================

print()
print("Creating reconciliation report...")

with pd.ExcelWriter(
    OUTPUT_FILE,
    engine="openpyxl"
) as writer:

    summary.to_excel(
        writer,
        sheet_name="Summary",
        index=False
    )

    mismatches.to_excel(
        writer,
        sheet_name="Mismatches",
        index=False
    )

    missing_output.to_excel(
        writer,
        sheet_name="Missing_In_Target",
        index=False
    )

    extra_output.to_excel(
        writer,
        sheet_name="Extra_In_Target",
        index=False
    )

    column_summary.to_excel(
        writer,
        sheet_name="Column_Summary",
        index=False
    )

    all_results.to_excel(
        writer,
        sheet_name="All_Results",
        index=False
    )


# ============================================================
# FINAL SUMMARY
# ============================================================

execution_time = (
    time.time() - start_time
)

print()
print("==============================================")
print("       RECONCILIATION COMPLETED")
print("==============================================")

print(
    f"Source records        : "
    f"{len(source):,}"
)

print(
    f"Target records        : "
    f"{len(target):,}"
)

print(
    f"Records present in both: "
    f"{len(both):,}"
)

print(
    f"Exact matches         : "
    f"{len(exact_match_ids):,}"
)

print(
    f"Records with mismatch : "
    f"{len(mismatched_ids):,}"
)

print(
    f"Missing in target     : "
    f"{len(missing_in_target):,}"
)

print(
    f"Extra in target       : "
    f"{len(extra_in_target):,}"
)

print(
    f"Columns compared      : "
    f"{len(compare_columns):,}"
)

print(
    f"Execution time        : "
    f"{execution_time:.2f} seconds"
)

print()
print(
    f"Report: {OUTPUT_FILE}"
)
