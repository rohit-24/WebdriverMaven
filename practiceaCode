} else if (type === "date" || (await input.getAttribute("readonly")) !== null) {
  const elementHandle = await input.first().elementHandle();
  const today = new Date().toISOString().split("T")[0]; // yyyy-mm-dd

  await this.page.evaluate((el, value) => {
    (el as HTMLInputElement).value = value;
    el.dispatchEvent(new Event("input", { bubbles: true })); // trigger Angular binding
    el.dispatchEvent(new Event("change", { bubbles: true }));
  }, elementHandle, today);

  console.log(`✅ Set date for [${labelText}]`);
}
