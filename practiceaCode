import re

def extract_cypress_test(file_path: str) -> list[str]:
    step_keywords = ("Given", "When", "Then", "And")
    steps = []

    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if line.startswith(step_keywords):
                steps.append(line)

    return steps
