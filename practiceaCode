async mockStatus(tabName: string) {
  await Basepage.pageObject.routeOnce(
    `**/v1/admin/loans/list?status=${tabName}*`,
    async route => {
      const updatedMockData = {
        ...mockData,
        adminLoanConfig: [
          {
            ...mockData.adminLoanConfig[0],
            status: tabName
          }
        ]
      };

      await route.fulfill({
        status: 200,
        contentType: "application/json",
        body: JSON.stringify(updatedMockData)
      });
    }
  );
}
