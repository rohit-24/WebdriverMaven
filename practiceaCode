function main() {
  var dir = 'src/test/java/features';
  var fs = Java.type('java.nio.file.Files');
  var Paths = Java.type('java.nio.file.Paths');
  var Charset = Java.type('java.nio.charset.StandardCharsets');

  function walk(dirPath) {
    var fileList = [];
    var path = Paths.get(dirPath);
    var stream = fs.walk(path);
    var it = stream.iterator();
    while (it.hasNext()) {
      var file = it.next();
      if (fs.isRegularFile(file) && file.toString().endsWith('.feature')) {
        fileList.push(file.toString());
      }
    }
    return fileList;
  }

  var featureFiles = walk(dir);
  var count = 0;

  featureFiles.forEach(function(filePath) {
    var lines = fs.readAllLines(Paths.get(filePath), Charset.UTF_8);
    if (lines.size() >= 2) {
      var tagLine = lines.get(0).trim();         // e.g. @squad_Jatayu
      var featureLine = lines.get(1).trim();     // e.g. Feature: IBPM workflow sr

      var tagValue = tagLine.replace('@', '');   // squad_Jatayu
      var featureName = featureLine.replace('Feature:', '').trim();  // IBPM workflow sr

      var filePathParts = filePath.split(java.io.File.separator);
      var folderName = filePathParts[filePathParts.length - 2]; // e.g. ServiceRequest

      var newTagLine = '@' + featureName.toLowerCase().replace(/\s+/g, '-') + '_feature';
      var newFeatureLine = 'Feature: ' + tagValue + '-' + folderName;

      lines.set(0, newTagLine);
      lines.set(1, newFeatureLine);

      fs.write(Paths.get(filePath), lines, Charset.UTF_8);
      print('✅ Updated: ' + filePath);
      count++;
    }
  });

  print('\n🔁 Done. Total files updated: ' + count);
}
main();

