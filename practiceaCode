def main(person_name: str) -> dict:
    try:
        import urllib.request
        # Test with a simple ping
        urllib.request.urlopen("https://www.google.com", timeout=5)
        return {"status": "Internet works", "name": person_name}
    except Exception as e:
        return {"status": f"Blocked: {str(e)}", "name": person_name}
