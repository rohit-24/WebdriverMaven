import json

def process_test_results(response_text: str, scenario_title: str, scenario_index: int):
    """
    Processes the raw response text and returns a clean failure summary for .txt
    and a structured JSON object for .json output.

    Args:
        response_text (str): Raw LLM response.
        scenario_title (str): Feature + Scenario name.
        scenario_index (int): Index of the scenario in the test list.

    Returns:
        tuple: (summary_text_block, structured_json_object)
    """
    cleaned_text = response_text.strip()

    try:
        json_obj = json.loads(cleaned_text)
    except json.JSONDecodeError:
        json_obj = {
            "error": "Failed to parse response JSON",
            "raw_text": cleaned_text
        }

    summary_block = f"""--- Summary for Failure {scenario_index} ---
Scenario: {scenario_title}
{json.dumps(json_obj, indent=2)}

"""

    return summary_block, json_obj
