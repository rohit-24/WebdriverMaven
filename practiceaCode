import { tool } from "@langchain/core/tools";
import { z } from "zod";

/**
 * Weather Tool
 * Input: city (string)
 * Output: weather info (string)
 */
export const getWeatherTool = tool(
  async ({ city }) => {
    // 🔹 Hardcoded weather data for now
    const weatherData: Record<string, string> = {
      Singapore: "🌤️ 30°C, Humid",
      Bangalore: "🌦️ 24°C, Cloudy",
      Mumbai: "☀️ 32°C, Hot",
      London: "🌧️ 15°C, Rainy",
    };

    return (
      weatherData[city] ??
      "❓ Weather data not available for this city"
    );
  },
  {
    name: "get_weather",
    description: "Get current weather for a given city",
    schema: z.object({
      city: z
        .string()
        .describe("Name of the city to get weather for"),
    }),
  }
);


import { createReactAgent } from "@langchain/langgraph/prebuilt";
import { getWeatherTool } from "./weatherTool.js";
import { GatewayLLM } from "./GatewayLLM.js";

async function main() {
  const llm = new GatewayLLM();

  const agent = createReactAgent({
    llm,
    tools: [getWeatherTool],
  });

  const response = await agent.invoke({
    messages: [
      {
        role: "user",
        content: "What is the weather in Singapore?",
      },
    ],
  });

  console.log(response.messages.at(-1)?.content);
}

main().catch(console.error);


