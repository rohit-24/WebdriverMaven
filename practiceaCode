// Playwright version of the document upload test
const { test, expect } = require(’@playwright/test’);

test(‘should select string from document type dropdown and enter remark for string MFF’, async ({ page }) => {
// Navigate to the page with the document upload widget
// await page.goto(‘your-url-here’);

// Get the document upload widget and perform actions
await page.locator(’.case-documents_file-upload’).hover();

// Click to open the dropdown
await page.locator(‘dbs-dropdown .select-dropdown-icon’).click();

// Select the dropdown option containing the dropdown value
await page.locator(“div[id$=’-selectoption’]”).filter({ hasText: ‘your-dropdown-value’ }).click();

// Verify the selection is displayed in dropdown box
await expect(page.locator(’.dropdown-box’)).toHaveText(‘have.text’, { timeout: 10000 });

// Enter remark in the text input field
await page.locator(“input[type=‘text’][maxlength=‘500’]”).last().clear();
await page.locator(“input[type=‘text’][maxlength=‘500’]”).last().type(‘your-remark-text’);
await expect(page.locator(“input[type=‘text’][maxlength=‘500’]”).last()).toHaveValue(‘your-remark-text’);

// Click the upload button
await page.locator(‘button:has-text(“upload”)’).click();
});
