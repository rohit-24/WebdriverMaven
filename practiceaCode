const HEADING_SELECTOR = 'h1,h2,h3,h4,h5,h6,legend,[role="heading"]';

function getLabelFor(el, doc){
  if(el.id){
    try{
      const lab = doc.querySelector(`label[for="${CSS.escape(el.id)}"]`);
      if(lab && lab.textContent.trim()) return lab.textContent.trim();
    }catch(e){}
  }
  const parentLabel = el.closest('label');
  if(parentLabel){
    const t = parentLabel.textContent.trim();
    if(t) return t;
  }
  if(el.getAttribute('aria-label')) return el.getAttribute('aria-label').trim();
  if(el.getAttribute('placeholder')) return el.getAttribute('placeholder').trim();
  let prev = el.previousElementSibling;
  let hops=0;
  while(prev && hops<3){
    const t = prev.textContent.trim();
    if(t && t.length<100 && !['input','select','textarea'].includes(prev.tagName.toLowerCase())) return t;
    prev = prev.previousElementSibling; hops++;
  }
  return el.name || el.id || '';
}

function extractFields(htmlText){
  const doc = new DOMParser().parseFromString(htmlText, 'text/html');
  const results = [];
  let currentSection = 'General';
  if(!doc.body) return results;

  const walker = doc.body.querySelectorAll('*');
  walker.forEach(el=>{
    const tag = el.tagName.toLowerCase();
    if(el.matches(HEADING_SELECTOR)){
      const t = el.textContent.trim();
      if(t) currentSection = t;
      return;
    }
    if(tag==='input' || tag==='select' || tag==='textarea'){
      if(tag==='input' && ['hidden','submit','button','image','file'].includes((el.type||'').toLowerCase())) return;
      const label = getLabelFor(el, doc);
      let value;
      if(tag==='select'){
        const opt = el.options[el.selectedIndex];
        value = opt ? opt.text.trim() : '';
      } else if(el.type==='checkbox' || el.type==='radio'){
        value = el.checked ? 'checked' : 'unchecked';
      } else {
        value = (el.value ?? el.getAttribute('value') ?? '').trim();
      }
      if(label) results.push({section: currentSection, label, value, tag});
    }
  });

  // fallback: definition list pairs
  doc.querySelectorAll('dt').forEach(dt=>{
    const dd = dt.nextElementSibling;
    if(dd && dd.tagName.toLowerCase()==='dd'){
      const label = dt.textContent.trim();
      if(label) results.push({section: currentSection, label, value: dd.textContent.trim(), tag:'dt/dd'});
    }
  });

  // fallback: two-cell table rows (label/value style)
  doc.querySelectorAll('tr').forEach(tr=>{
    const cells = tr.querySelectorAll('td,th');
    if(cells.length===2){
      const label = cells[0].textContent.trim();
      const value = cells[1].textContent.trim();
      if(label && !results.some(r=>r.label===label && r.value===value)){
        results.push({section: currentSection, label, value, tag:'tr'});
      }
    }
  });

  return results;
}

function normLabel(s){ return s.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }

function matchFields(fieldsA, fieldsB){
  const usedB = new Array(fieldsB.length).fill(false);
  const results = [];

  fieldsA.forEach(fa=>{
    const key = normLabel(fa.label);
    let matchIdx = fieldsB.findIndex((fb,idx)=> !usedB[idx] && normLabel(fb.label)===key);
    if(matchIdx===-1){
      let best=-1, bestScore=0;
      fieldsB.forEach((fb,idx)=>{
        if(usedB[idx]) return;
        const score = similarity(key, normLabel(fb.label));
        if(score>bestScore){ bestScore=score; best=idx; }
      });
      if(bestScore>=0.75) matchIdx = best;
    }
    if(matchIdx!==-1){
      usedB[matchIdx]=true;
      const fb = fieldsB[matchIdx];
      const sameSection = fa.section===fb.section;
      const sameValue = fa.value===fb.value;
      let status;
      if(sameValue && sameSection) status='retained';
      else if(sameValue && !sameSection) status='moved';
      else status='changed';
      results.push({label:fa.label, fromSection:fa.section, toSection:fb.section, fromValue:fa.value, toValue:fb.value, status});
    } else {
      results.push({label:fa.label, fromSection:fa.section, fromValue:fa.value, status:'removed'});
    }
  });

  fieldsB.forEach((fb,idx)=>{
    if(!usedB[idx]) results.push({label:fb.label, toSection:fb.section, toValue:fb.value, status:'added'});
  });

  return results;
}

function renderFieldRow(r){
  const showCls = r.status==='retained' ? (document.getElementById('showRetained').checked ? ' show':'') : '';
  let body;
  if(r.status==='moved'){
    body = `<div class="fmeta">moved: ${escapeHtml(r.fromSection)} <span class="arrow">→</span> ${escapeHtml(r.toSection)} · value retained: <span class="fval">${escapeHtml(r.toValue||'(empty)')}</span></div>`;
  } else if(r.status==='changed'){
    body = `<div class="fmeta">${escapeHtml(r.fromSection===r.toSection ? r.fromSection : r.fromSection+' → '+r.toSection)}</div>
            <div class="fval"><span class="old">${escapeHtml(r.fromValue||'(empty)')}</span><span class="arrow">→</span><b>${escapeHtml(r.toValue||'(empty)')}</b></div>`;
  } else if(r.status==='added'){
    body = `<div class="fmeta">new in ${escapeHtml(r.toSection)}</div><div class="fval">${escapeHtml(r.toValue||'(empty)')}</div>`;
  } else if(r.status==='removed'){
    body = `<div class="fmeta">no longer present — was in ${escapeHtml(r.fromSection)}</div><div class="fval">${escapeHtml(r.fromValue||'(empty)')}</div>`;
  } else {
    body = `<div class="fmeta">${escapeHtml(r.toSection||r.fromSection)}</div><div class="fval">${escapeHtml(r.toValue ?? r.fromValue ?? '')}</div>`;
  }
  return `<div class="field-row status-${r.status}${showCls}"><div class="flabel">${escapeHtml(r.label)}</div>${body}</div>`;
}

function buildHtmlSummary(counts){
  const banner = document.getElementById('htmlSummaryBanner');
  banner.style.display='flex';
  const {added,removed,changed,moved,retained} = counts;
  if(added===0 && removed===0 && changed===0 && moved===0){
    banner.className='summary-banner neutral';
    banner.innerHTML = `<span class="icon">✅</span><span>No differences found — all ${retained} detected fields match exactly.</span>`;
    return;
  }
  const parts=[];
  if(moved>0) parts.push(`<b>${moved}</b> field${moved===1?'':'s'} moved to a different section (value retained)`);
  if(changed>0) parts.push(`<b>${changed}</b> field${changed===1?'':'s'} with a changed value`);
  if(added>0) parts.push(`<b>${added}</b> new field${added===1?'':'s'} added`);
  if(removed>0) parts.push(`<b>${removed}</b> field${removed===1?'':'s'} removed`);
  let sentence = parts.join(', ').replace(/,([^,]*)$/, ' and$1') + '.';
  banner.className='summary-banner';
  banner.innerHTML = `<span class="icon">${removed>0||changed>0?'⚠️':'↕️'}</span><span>${sentence}</span>`;
}

document.getElementById('runHtmlDiff').addEventListener('click', ()=>{
  document.getElementById('htmlProgress').textContent = 'Parsing DOM…';
  try{
    const fieldsA = extractFields(htmlState.textA);
    const fieldsB = extractFields(htmlState.textB);

    if(fieldsA.length===0 && fieldsB.length===0){
      document.getElementById('fieldDiffContainer').className='empty';
      document.getElementById('fieldDiffContainer').textContent = 'No form fields, dt/dd pairs, or two-column table rows were found in either source. This page may render its UI via a heavily scripted framework — try saving the page after it fully loads ("Save As → Complete Webpage") rather than the raw template source.';
      document.getElementById('htmlProgress').textContent='';
      return;
    }

    const diff = matchFields(fieldsA, fieldsB);
    const counts = {
      added: diff.filter(d=>d.status==='added').length,
      removed: diff.filter(d=>d.status==='removed').length,
      changed: diff.filter(d=>d.status==='changed').length,
      moved: diff.filter(d=>d.status==='moved').length,
      retained: diff.filter(d=>d.status==='retained').length,
    };

    document.getElementById('htmlStats').innerHTML = `
      <div class="stat"><div class="num" style="color:#b8863b">${counts.moved}</div><div class="lbl">Moved</div></div>
      <div class="stat"><div class="num" style="color:var(--removed)">${counts.changed}</div><div class="lbl">Changed</div></div>
      <div class="stat"><div class="num" style="color:var(--added)">${counts.added}</div><div class="lbl">Added</div></div>
      <div class="stat"><div class="num" style="color:var(--removed)">${counts.removed}</div><div class="lbl">Removed</div></div>
      <div class="stat"><div class="num">${counts.retained}</div><div class="lbl">Retained</div></div>
    `;
    buildHtmlSummary(counts);

    // order: moved, changed, added, removed, retained
    const order = {moved:0, changed:1, added:2, removed:3, retained:4};
    diff.sort((a,b)=> order[a.status]-order[b.status]);

    document.getElementById('fieldDiffContainer').className='field-diff-list';
    document.getElementById('fieldDiffContainer').innerHTML = diff.map(renderFieldRow).join('');
    document.getElementById('htmlProgress').textContent='Done.';
    setTimeout(()=> document.getElementById('htmlProgress').textContent='', 1500);
  }catch(err){
    document.getElementById('htmlProgress').textContent='';
    document.getElementById('fieldDiffContainer').className='empty';
    document.getElementById('fieldDiffContainer').textContent = 'Could not parse the HTML source: '+err.message;
  }
});
