async isTransactionVisible(transactionId: string) {
  if (!transactionId) {
    throw new Error('transactionId is required');
  }

  const maxAttempts = 3;
  const retryInterval = 30000; // 30 seconds

  await this.page.getByText('Trade Finance', { exact: true }).click();

  // Open Import Letter of Credit
  await this.page.locator('#N001_LC').click();

  const searchBox = this.page.locator('#searchBox');

  await expect(searchBox).toBeVisible({
    timeout: 30000
  });

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    console.log(
      `Searching for transaction ${transactionId} - Attempt ${attempt}/${maxAttempts}`
    );

    // Clear previous search
    await searchBox.fill('');

    // Enter transaction ID
    await searchBox.fill(transactionId);

    try {
      // Look specifically for the transaction row
      const transactionRow = this.page.locator(
        `tr#rowdata:has-text("${transactionId}")`
      );

      // Wait for transaction to appear
      await expect(transactionRow).toBeVisible({
        timeout: retryInterval
      });

      // Verify transaction ID
      await expect(transactionRow).toContainText(transactionId);

      // Verify transaction type
      await expect(transactionRow).toContainText('RTB_QA_ILC');

      console.log(
        `Transaction ${transactionId} verified successfully in LOTS on attempt ${attempt}`
      );

      // Found successfully - stop retrying
      return true;

    } catch (error) {
      console.log(
        `Transaction ${transactionId} not found on attempt ${attempt}/${maxAttempts}`
      );

      // If this was the final attempt, fail
      if (attempt === maxAttempts) {
        throw new Error(
          `Transaction ${transactionId} was not found in LOTS after ${maxAttempts} attempts`
        );
      }

      // Wait before next search
      console.log(
        `Waiting ${retryInterval / 1000} seconds before retrying...`
      );

      await this.page.waitForTimeout(retryInterval);
    }
  }

  return false;
}
