(() => {
  const container = document.querySelector('.your-class-name');
  if (!container) {
    console.error('Container not found');
    return;
  }

  const getRole = el =>
    el.getAttribute('role') ||
    ({
      BUTTON: 'button',
      A: el.href ? 'link' : '',
      INPUT: ({
        text: 'textbox',
        email: 'textbox',
        search: 'textbox',
        password: 'textbox',
        checkbox: 'checkbox',
        radio: 'radio',
        submit: 'button',
        button: 'button'
      })[el.type],
      TEXTAREA: 'textbox',
      SELECT: 'combobox',
      IMG: 'img',
      H1: 'heading',
      H2: 'heading',
      H3: 'heading',
      H4: 'heading',
      H5: 'heading',
      H6: 'heading'
    })[el.tagName];

  const getName = el =>
    el.getAttribute('aria-label') ||
    el.labels?.[0]?.innerText ||
    el.placeholder ||
    el.innerText?.trim() ||
    el.value ||
    el.alt ||
    '';

  [...container.querySelectorAll('*')].forEach(el => {
    const role = getRole(el);
    if (!role) return;

    const name = getName(el).replace(/\s+/g, ' ').trim();

    console.log(
      name
        ? `await page.getByRole('${role}', { name: '${name.replace(/'/g, "\\'")}' });`
        : `await page.getByRole('${role}');`
    );
  });
})();
