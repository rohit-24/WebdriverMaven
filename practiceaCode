function scrollToBottomUntilNoMoreContent(waitTime = 1000) {
  let previousHeight = 0;

  function scroll() {
    cy.document().then((doc) => {
      const el = doc.documentElement;
      const currentHeight = el.scrollHeight;
      const clientHeight = el.clientHeight;

      // 🚫 Not scrollable
      if (currentHeight <= clientHeight) {
        cy.log('Page is not scrollable — exiting scroll.');
        return;
      }

      // ✅ Continue if content height increased
      if (currentHeight > previousHeight) {
        previousHeight = currentHeight;
        cy.scrollTo('bottom');
        cy.wait(waitTime).then(() => scroll());
      } else {
        cy.log('No more content to scroll — exiting.');
      }
    });
  }

  scroll();
}

