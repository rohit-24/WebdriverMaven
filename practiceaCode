function preprocessCanvas(img){
  // upscale small images for better OCR, and boost contrast / grayscale
  const targetW = Math.min(2400, Math.max(img.width, 1400));
  const scale = targetW / img.width;
  const canvas = document.createElement('canvas');
  canvas.width = Math.round(img.width*scale);
  canvas.height = Math.round(img.height*scale);
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(img,0,0,canvas.width,canvas.height);
  const id = ctx.getImageData(0,0,canvas.width,canvas.height);
  const d = id.data;
  for(let i=0;i<d.length;i+=4){
    const gray = 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
    const boosted = Math.min(255, Math.max(0, (gray-128)*1.35+128));
    d[i]=d[i+1]=d[i+2]=boosted;
  }
  ctx.putImageData(id,0,0);
  return canvas;
}

async function ocrImage(img, label){
  setProgress(`Reading text from "${label}"…`);
  const canvas = preprocessCanvas(img);
  const { data } = await Tesseract.recognize(canvas, 'eng', {
    logger: m=>{
      if(m.status==='recognizing text'){
        setProgress(`Reading text from "${label}"… ${Math.round(m.progress*100)}%`);
      }
    }
  });

  const rawLines = (data.lines && data.lines.length) ? data.lines : null;
  let lines = [];
  let confSum=0, confCount=0;

  if(rawLines){
    rawLines.forEach(l=>{
      const text = (l.text||'').trim().replace(/\s+/g,' ');
      if(!text) return;
      const conf = l.confidence ?? 0;
      confSum += conf; confCount++;
      const alnum = (text.match(/[a-zA-Z0-9]/g)||[]).length;
      const alnumRatio = alnum / text.length;
      // filter obvious OCR junk: low confidence or mostly symbols or too short
      if(conf >= 40 && alnumRatio >= 0.35 && text.replace(/[^a-zA-Z0-9]/g,'').length >= 2){
        lines.push(text);
      }
    });
  } else {
    lines = data.text.split('\n').map(l=>l.trim().replace(/\s+/g,' ')).filter(l=>l.length>=2);
    confSum = data.confidence||0; confCount=1;
  }

  const avgConfidence = confCount ? confSum/confCount : 0;
  return { lines, avgConfidence };
}

// Levenshtein distance -> similarity ratio 0..1
function similarity(a,b){
  a=a.toLowerCase(); b=b.toLowerCase();
  if(a===b) return 1;
  const n=a.length,m=b.length;
  if(!n||!m) return 0;
  const dp=Array.from({length:n+1},()=> new Uint16Array(m+1));
  for(let i=0;i<=n;i++) dp[i][0]=i;
  for(let j=0;j<=m;j++) dp[0][j]=j;
  for(let i=1;i<=n;i++){
    for(let j=1;j<=m;j++){
      dp[i][j] = a[i-1]===b[j-1] ? dp[i-1][j-1] : 1+Math.min(dp[i-1][j],dp[i][j-1],dp[i-1][j-1]);
    }
  }
  const dist = dp[n][m];
  return 1 - dist/Math.max(n,m);
}

// classic LCS-based line diff (case-insensitive match)
function diffLines(a, b){
  const an = a.map(l=>l.toLowerCase());
  const bn = b.map(l=>l.toLowerCase());
  const n=a.length, m=b.length;
  const dp = Array.from({length:n+1},()=>new Uint16Array(m+1));
  for(let i=n-1;i>=0;i--){
    for(let j=m-1;j>=0;j--){
      dp[i][j] = an[i]===bn[j] ? dp[i+1][j+1]+1 : Math.max(dp[i+1][j], dp[i][j+1]);
    }
  }
  const result=[];
  let i=0,j=0;
  while(i<n && j<m){
    if(an[i]===bn[j]){ result.push({type:'same', text:a[i]}); i++; j++; }
    else if(dp[i+1][j] >= dp[i][j+1]){ result.push({type:'removed', text:a[i]}); i++; }
    else { result.push({type:'added', text:b[j]}); j++; }
  }
  while(i<n){ result.push({type:'removed', text:a[i]}); i++; }
  while(j<m){ result.push({type:'added', text:b[j]}); j++; }
  return result;
}

// merge adjacent removed+added pairs that are similar enough into a single "changed" entry
function mergeChanges(diff){
  const out = [];
  for(let k=0;k<diff.length;k++){
    const cur = diff[k], next = diff[k+1];
    if(cur.type==='removed' && next && next.type==='added'){
      const sim = similarity(cur.text, next.text);
      if(sim >= 0.45){
        out.push({type:'changed', from:cur.text, to:next.text});
        k++; // consume both
        continue;
      }
    }
    out.push(cur);
  }
  return out;
}

function renderDiffLine(d){
  if(d.type==='changed'){
    return `<div class="diff-line changed"><span class="old">${escapeHtml(d.from)}</span><span class="arrow">→</span><span class="new">${escapeHtml(d.to)}</span></div>`;
  }
  const showCls = d.type==='same' ? (document.getElementById('showSame').checked ? ' show':'') : '';
  return `<div class="diff-line ${d.type}${showCls}">${escapeHtml(d.text)}</div>`;
}

function buildSummary(added, removed, changed, retained){
  const banner = document.getElementById('summaryBanner');
  banner.style.display = 'flex';

  if(added===0 && removed===0 && changed===0){
    banner.className = 'summary-banner neutral';
    banner.innerHTML = `<span class="icon">✅</span><span>No differences found — all ${retained} detected line${retained===1?'':'s'} match between the two screenshots.</span>`;
    return;
  }

  const parts = [];
  if(changed>0) parts.push(`<b>${changed}</b> field${changed===1?'':'s'} moved or updated (value carried over)`);
  if(added>0) parts.push(`<b>${added}</b> new line${added===1?'':'s'} added`);
  if(removed>0) parts.push(`<b>${removed}</b> line${removed===1?'':'s'} removed`);

  let sentence = parts.join(', ').replace(/,([^,]*)$/, ' and$1') + '.';
  if(removed===0 && added===0){
    sentence += ' Nothing appears to have been lost or newly introduced.';
  }

  banner.className = 'summary-banner';
  banner.innerHTML = `<span class="icon">${removed>0 ? '⚠️' : '↕️'}</span><span>${sentence}</span>`;
}

async function runTextDiff(){
  document.getElementById('runText').disabled = true;
  document.getElementById('runVisual').disabled = true;
  document.getElementById('qualityNote').classList.remove('show');
  try{
    const resA = await ocrImage(state.imgA, 'Before');
    const resB = await ocrImage(state.imgB, 'After');

    if(resA.avgConfidence < 55 || resB.avgConfidence < 55){
      document.getElementById('qualityNote').classList.add('show');
    }

    const rawDiff = diffLines(resA.lines, resB.lines);
    const diff = mergeChanges(rawDiff);

    const added = diff.filter(d=>d.type==='added').length;
    const removed = diff.filter(d=>d.type==='removed').length;
    const changed = diff.filter(d=>d.type==='changed').length;
    const retained = diff.filter(d=>d.type==='same').length;

    document.getElementById('textStats').innerHTML = `
      <div class="stat"><div class="num" style="color:var(--added)">${added}</div><div class="lbl">Added</div></div>
      <div class="stat"><div class="num" style="color:var(--removed)">${removed}</div><div class="lbl">Removed</div></div>
      <div class="stat"><div class="num" style="color:#b8863b">${changed}</div><div class="lbl">Changed</div></div>
      <div class="stat"><div class="num">${retained}</div><div class="lbl">Retained</div></div>
    `;
    buildSummary(added, removed, changed, retained);
    const html = diff.map(renderDiffLine).join('');
    document.getElementById('textContent').className='diff-lines';
    document.getElementById('textContent').innerHTML = html || '<div class="empty">No reliable text detected in either screenshot.</div>';
    setProgress('Done.');
  }catch(err){
    setProgress('');
    document.getElementById('summaryBanner').style.display='none';
    document.getElementById('textContent').className='empty';
    document.getElementById('textContent').textContent = 'OCR failed to load — check your internet connection (needed once, to fetch the recognition engine), then try again. Error: '+err.message;
  }
  document.getElementById('runText').disabled = false;
  document.getElementById('runVisual').disabled = false;
  setTimeout(()=>setProgress(''), 1500);
}

function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

