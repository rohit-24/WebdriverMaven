def extract_cypress_test(file_path: str) -> str:
    with open(file_path, 'r', encoding='utf-8') as f:
        return f.read()


def generate_playwright_files(response: str):
    page_obj = extract_section(response, "Playwright Page Object")
    steps = extract_section(response, "Step Definition")

    with open("Reports/output/audit_log.page.ts", "w") as f:
        f.write(page_obj)

    with open("Reports/output/audit_log.steps.ts", "w") as f:
        f.write(steps)

