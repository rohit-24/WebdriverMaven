
def extract_section(response: str, section_name: str) -> str:
    """
    Extracts the content between section headers like:
    ### PageObject
    ### StepDefinition
    """
    # Matches: ### PageObject\n<content>\n### or end of file
    pattern = rf"###\s*{section_name}\s*\n(.*?)(?=\n###\s*\w+|\Z)"
    match = re.search(pattern, response, re.DOTALL | re.IGNORECASE)
    
    if match:
        content = match.group(1).strip()
        print(f"✅ Found and extracted clean '{section_name}' section")
        return content
    else:
        print(f"❌ Section '{section_name}' not found in LLM output.")
        return f"// Section '{section_name}' not found in LLM output"
