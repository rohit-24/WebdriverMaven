def process_test_results(response_text: str, scenario_title: str, scenario_index: int) -> str:
    """
    Processes the raw response text and formats it into a clean failure summary block for .txt output.

    Args:
        response_text: Raw LLM response.
        scenario_title: Feature + Scenario name.
        scenario_index: Index of the scenario in the test list.

    Returns:
        str: Formatted failure summary for .txt file.
    """
    cleaned_text = response_text.strip()
    
    summary_block = f"""--- Summary for Scenario {scenario_index} ---
Scenario: {scenario_title}
{cleaned_text}

"""
    return summary_block




