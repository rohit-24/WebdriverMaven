
} else if (await checkbox.count() > 0) {
  // ☑️ Checkbox with potential dummy labels
  const inputHandle = checkbox.first();
  const id = await inputHandle.getAttribute("id");

  if (id) {
    // Pick the label tied to this checkbox (not the empty &nbsp one)
    const linkedLabel = this.page.locator(`label[for="${id}"]`);
    
    if (await linkedLabel.isVisible()) {
      await linkedLabel.click();
      console.log(`✅ Clicked label for checkbox [${labelText}]`);
    } else {
      // Fallback if label not visible → force check the input
      await this.page.evaluate((el) => (el as HTMLInputElement).checked = true, 
                               await inputHandle.elementHandle());
      console.log(`⚡ Forced checked hidden checkbox [${labelText}]`);
    }
  }
}




