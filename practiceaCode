async fillDynamicForm() {
  const allLabels = this.page.locator("label");
  const labelCount = await allLabels.count();

  for (let i = 0; i < labelCount; i++) {
    let labelText = (await allLabels.nth(i).innerText()).trim();
    if (!labelText || labelText === "\u00A0") continue;

    const label = allLabels.nth(i);
    const container = label.locator("..");
    const input = container.locator("input");
    const select = container.locator("select");
    const checkbox = container.locator('input[type="checkbox"]');
    const dateField = container.locator("input[readonly]");
    const customDropdown = container.locator(".form-input.selectDropdown"); // 🚀 custom dropdown

    // 📅 Date fields
    if (await dateField.count() > 0) {
      const today = new Date();
      const day = String(today.getDate()).padStart(2, "0");

      await dateField.first().click();
      await this.page.waitForSelector(".calendar");
      await this.page.locator(`.calendar .day:not(.disabled):has-text("${day}")`).first().click();

      console.log(`📅 Picked date [${labelText}] = ${day}`);
    }

    // 📝 Text/number inputs
    else if (await input.count() > 0 && !(await checkbox.count() > 0)) {
      const dummyValue = `${labelText.replace(/\s+/g, "_")}_Test`;
      await input.fill(dummyValue);
      console.log(`✅ Filled input [${labelText}] = ${dummyValue}`);
    }

    // ✅ Checkbox
    else if (await checkbox.count() > 0) {
      const inputHandle = checkbox.first();
      const id = await inputHandle.getAttribute("id");

      if (id) {
        const linkedLabel = this.page.locator(`label[for="${id}"]`);
        if (await linkedLabel.isVisible()) {
          await linkedLabel.scrollIntoViewIfNeeded();
          await linkedLabel.click();
        } else {
          await this.page.evaluate(
            (el) => (el as HTMLInputElement).checked = true,
            await inputHandle.elementHandle()
          );
        }
        console.log(`☑️ Checked checkbox [${labelText}]`);
      }
    }

    // 🔽 Native <select>
    else if (await select.count() > 0) {
      const options = await select.locator("option").all();
      if (options.length > 1) {
        const value = await options[1].getAttribute("value");
        if (value) {
          await select.selectOption(value);
          console.log(`🔽 Selected native [${labelText}] = ${value}`);
        }
      }
    }

    // 🔽 Custom dropdown (Angular style)
    else if (await customDropdown.count() > 0) {
      const dropdown = customDropdown.first();

      await dropdown.locator(".dropdown-box").click({ force: true });
      const firstOption = dropdown.locator(".options-container ul li").first();
      await firstOption.click({ force: true });

      const selectedText = await firstOption.innerText();
      console.log(`🔽 Selected custom [${labelText}] = ${selectedText}`);
    }
  }
}
