def extract_cypress_test(file_path: str) -> list[str]:
    step_keywords = ("Given", "When", "Then", "And")
    steps = []

    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            stripped = line.strip()

            # Skip empty lines
            if not stripped:
                continue

            # Skip lines that are const/import/require using step keywords
            if "const" in stripped and any(kw in stripped for kw in step_keywords):
                continue
            if "require" in stripped and any(kw in stripped for kw in step_keywords):
                continue
            if "import" in stripped and any(kw in stripped for kw in step_keywords):
                continue

            # Include only lines that start with Given/When/Then/And
            if any(stripped.startswith(kw) for kw in step_keywords):
                steps.append(stripped)

    return steps
