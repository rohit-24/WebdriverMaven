def build_llm_prompt(context, tested_endpoints, openapi_endpoints):
    return f"""
You are an expert API testing assistant.

Below are two lists for the context: **{context}**

🟢 **Tested API Endpoints** (from Karate tests):
{sorted(tested_endpoints)}

🔵 **Expected API Endpoints** (from OpenAPI spec):
{sorted(openapi_endpoints)}

---

🔍 Please:
1. Identify which endpoints are tested vs missing
2. Compute code coverage percentage
3. List missing endpoints
4. Provide recommendations
5. Give a final summary in bullet points
"""
