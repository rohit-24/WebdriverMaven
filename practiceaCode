<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Screenshot Diff — Compare UI Screenshots</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/5.0.4/tesseract.min.js"></script>
<style>
  :root{
    --ink:#151a23;
    --paper:#f6f5f1;
    --panel:#ffffff;
    --line:#e2ded3;
    --accent:#2f6f5e;
    --accent-soft:#e7f1ed;
    --added:#1f8a4c;
    --added-bg:#e5f6ec;
    --removed:#c23b3b;
    --removed-bg:#fbeaea;
    --muted:#6b7280;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:28px 20px 80px;}
  header{
    display:flex;justify-content:space-between;align-items:flex-end;
    border-bottom:2px solid var(--ink);
    padding-bottom:16px;margin-bottom:28px;flex-wrap:wrap;gap:12px;
  }
  .brand{display:flex;align-items:baseline;gap:10px;}
  .brand .mark{
    width:14px;height:14px;background:var(--accent);
    display:inline-block;border-radius:3px;transform:translateY(1px);
  }
  h1{font-size:22px;margin:0;letter-spacing:-0.02em;font-weight:700;}
  .tagline{color:var(--muted);font-size:13px;margin-top:2px;}
  .badge{
    font-family:var(--mono);font-size:11px;color:var(--muted);
    border:1px solid var(--line);border-radius:20px;padding:5px 12px;
    background:var(--panel);
  }

  .upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
  @media(max-width:720px){.upload-grid{grid-template-columns:1fr;}}
  .dropzone{
    background:var(--panel);border:1.5px dashed var(--line);border-radius:14px;
    padding:22px;text-align:center;cursor:pointer;transition:.15s ease;position:relative;
    min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  }
  .dropzone:hover{border-color:var(--accent);background:var(--accent-soft);}
  .dropzone.filled{padding:10px;cursor:default;}
  .dropzone.filled:hover{border-color:var(--line);background:var(--panel);}
  .dropzone .label{
    font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent);font-weight:600;margin-bottom:8px;
  }
  .dropzone .hint{color:var(--muted);font-size:13px;}
  .dropzone img{max-width:100%;max-height:260px;border-radius:8px;display:block;box-shadow:0 1px 4px rgba(0,0,0,.12);}
  .dropzone .filename{font-size:12px;color:var(--muted);margin-top:8px;font-family:var(--mono);word-break:break-all;padding:0 8px;}
  .dropzone input{display:none;}
  .swap-note{grid-column:1/-1;text-align:center;font-size:12px;color:var(--muted);margin-top:-8px;}

  .controls{
    display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;
  }
  button{
    font-family:var(--sans);font-size:13.5px;font-weight:600;
    border:1.5px solid var(--ink);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:9px;cursor:pointer;transition:.12s ease;
  }
  button:hover{transform:translateY(-1px);}
  button:disabled{opacity:.35;cursor:not-allowed;transform:none;}
  button.secondary{background:transparent;color:var(--ink);}
  .tabs{display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:4px;}
  .tab{
    padding:8px 14px;border-radius:7px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;
    user-select:none;
  }
  .tab.active{background:var(--ink);color:#fff;}

  .panel{
    background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;display:none;
  }
  .panel.active{display:block;}

  .stats-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
  .stat{
    border:1px solid var(--line);border-radius:10px;padding:12px 16px;min-width:120px;
  }
  .stat .num{font-size:22px;font-weight:700;font-family:var(--mono);}
  .stat .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;}

  #visualCanvasWrap{position:relative;overflow:auto;border:1px solid var(--line);border-radius:10px;background:repeating-conic-gradient(#f0efe9 0% 25%, #fff 0% 50%) 50% / 20px 20px;}
  #visualCanvas{display:block;max-width:100%;}

  .slider-wrap{position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);user-select:none;}
  .slider-wrap img{display:block;width:100%;pointer-events:none;}
  .slider-wrap .after-layer{position:absolute;top:0;left:0;height:100%;overflow:hidden;width:50%;border-right:2px solid var(--accent);}
  .slider-wrap .after-layer img{width:var(--fullwidth);max-width:none;}
  .slider-handle{
    position:absolute;top:50%;left:50%;width:34px;height:34px;background:var(--accent);
    border-radius:50%;transform:translate(-50%,-50%);cursor:ew-resize;
    display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;
    box-shadow:0 2px 8px rgba(0,0,0,.3);
  }
  .slider-range{width:100%;margin-top:14px;accent-color:var(--accent);}

  .legend{display:flex;gap:18px;margin-bottom:14px;font-size:12.5px;color:var(--muted);flex-wrap:wrap;}
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .swatch{width:12px;height:12px;border-radius:3px;display:inline-block;}

  .diff-lines{font-family:var(--mono);font-size:13px;line-height:1.9;word-break:break-word;}
  .diff-line{padding:5px 10px;border-radius:6px;margin-bottom:3px;}
  .diff-line.added{background:var(--added-bg);color:#0d5c31;}
  .diff-line.removed{background:var(--removed-bg);color:#8a2222;}
  .diff-line.changed{background:#fdf3e0;color:#7a5210;}
  .diff-line.added::before{content:"+  ";font-weight:700;}
  .diff-line.removed::before{content:"−  ";font-weight:700;}
  .diff-line.changed .old{text-decoration:line-through;text-decoration-color:#c9a96b;color:#9a6a1f;}
  .diff-line.changed .arrow{margin:0 8px;color:#b8863b;}
  .diff-line.changed .new{font-weight:700;}
  .diff-line.same{color:#9aa0aa;display:none;}
  .diff-line.same.show{display:block;}
  .diff-toggle{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:14px;user-select:none;cursor:pointer;}
  .diff-toggle input{accent-color:var(--accent);}
  .summary-banner{
    display:flex;align-items:center;gap:12px;
    background:var(--accent-soft);border:1px solid #bcd9cd;border-radius:12px;
    padding:14px 18px;margin-bottom:18px;font-size:14.5px;font-weight:600;color:#1d4a3d;
    line-height:1.5;
  }
  .summary-banner .icon{font-size:20px;flex-shrink:0;}
  .summary-banner.neutral{background:#f0efe9;border-color:var(--line);color:#4a4f58;}
  .quality-note{
    background:#fdf3e0;border:1px solid #e9cd93;border-radius:10px;padding:12px 14px;
    font-size:12.5px;color:#7a5210;margin-bottom:16px;line-height:1.6;display:none;
  }
  .quality-note.show{display:block;}

  .empty{color:var(--muted);font-size:14px;text-align:center;padding:40px 10px;}
  .progress{font-family:var(--mono);font-size:12px;color:var(--accent);margin-top:8px;min-height:16px;}
  .mode-switch{display:flex;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:5px;margin-bottom:22px;width:fit-content;}
  .mode-btn{
    padding:9px 18px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--muted);
    cursor:pointer;user-select:none;border:none;background:transparent;font-family:var(--sans);
  }
  .mode-btn.active{background:var(--ink);color:#fff;}
  .mode-panel{display:none;}
  .mode-panel.active{display:block;}

  .html-input-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
  @media(max-width:720px){.html-input-grid{grid-template-columns:1fr;}}
  .html-input-box{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;}
  .html-input-box .label{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
  .html-input-box .label button{padding:5px 10px;font-size:11px;border-radius:6px;}
  .html-input-box textarea{
    width:100%;height:160px;resize:vertical;border:1px solid var(--line);border-radius:8px;
    padding:10px;font-family:var(--mono);font-size:11.5px;color:var(--ink);background:#fbfaf7;
  }
  .html-input-box .filestat{font-size:11.5px;color:var(--muted);margin-top:6px;font-family:var(--mono);}

  .field-diff-list{display:flex;flex-direction:column;gap:8px;}
  .field-row{border:1px solid var(--line);border-radius:10px;padding:11px 14px;font-size:13.5px;}
  .field-row .flabel{font-weight:700;margin-bottom:4px;}
  .field-row .fmeta{font-family:var(--mono);font-size:12px;color:var(--muted);}
  .field-row.status-moved{background:#fdf3e0;border-color:#e9cd93;}
  .field-row.status-changed{background:var(--removed-bg);border-color:#ecb9b9;}
  .field-row.status-added{background:var(--added-bg);border-color:#a9dcbb;}
  .field-row.status-removed{background:var(--removed-bg);border-color:#ecb9b9;}
  .field-row.status-retained{background:#fbfaf7;display:none;}
  .field-row.status-retained.show{display:block;}
  .fval{font-family:var(--mono);}
  .fval .old{text-decoration:line-through;color:#9a6a1f;}
  .fval .arrow{margin:0 6px;color:#b8863b;}
  .footer-note{margin-top:26px;font-size:12px;color:var(--muted);line-height:1.6;}
  .footer-note code{background:var(--panel);border:1px solid var(--line);padding:1px 6px;border-radius:5px;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <span class="mark"></span>
      <div>
        <h1>Screenshot Diff</h1>
        <div class="tagline">Compare two screenshots — spot added, removed, or shifted content</div>
      </div>
    </div>
    <div class="badge">runs entirely in this browser tab</div>
  </header>

  <div class="mode-switch">
    <button class="mode-btn active" data-mode="image">Screenshots (image)</button>
    <button class="mode-btn" data-mode="html">Page source (HTML) — exact diff</button>
  </div>

  <div class="mode-panel active" id="mode-image">

  <div class="upload-grid">
    <div class="dropzone" id="dropA">
      <div class="label">Before</div>
      <div class="hint">Click or drop the earlier screenshot</div>
      <input type="file" id="fileA" accept="image/*">
    </div>
    <div class="dropzone" id="dropB">
      <div class="label">After</div>
      <div class="hint">Click or drop the newer screenshot</div>
      <input type="file" id="fileB" accept="image/*">
    </div>
  </div>

  <div class="controls">
    <button id="runVisual" disabled>Compare visually</button>
    <button id="runText" class="secondary" disabled>Extract & diff text (OCR)</button>
    <button id="reset" class="secondary">Reset</button>
    <div class="progress" id="progress"></div>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="visual">Visual diff</div>
    <div class="tab" data-tab="slider">Slider overlay</div>
    <div class="tab" data-tab="text">Text diff</div>
  </div>

  <div style="height:16px"></div>

  <div class="panel active" id="panel-visual">
    <div class="stats-row" id="visualStats"></div>
    <div class="legend">
      <span><span class="swatch" style="background:#c23b3b"></span> changed region</span>
    </div>
    <div id="visualCanvasWrap"><canvas id="visualCanvas"></canvas></div>
    <div class="empty" id="visualEmpty">Upload both screenshots, then click "Compare visually."</div>
  </div>

  <div class="panel" id="panel-slider">
    <div id="sliderContainer" class="empty">Upload both screenshots to preview the overlay slider.</div>
  </div>

  <div class="panel" id="panel-text">
    <div class="summary-banner" id="summaryBanner" style="display:none"></div>
    <div class="stats-row" id="textStats"></div>
    <div class="quality-note" id="qualityNote">⚠ Low OCR confidence detected — this usually means the image is a photo of a screen (moiré pattern) rather than an actual screenshot file. For a reliable field-level diff, export or save the real screenshot (PNG/JPG) instead of photographing the monitor. The visual diff and slider tabs still work fine with photos.</div>
    <label class="diff-toggle"><input type="checkbox" id="showSame"> Show unchanged lines too</label>
    <div id="textContent" class="empty">Click "Extract & diff text (OCR)" to compare the actual field labels, values, and copy on each screenshot. This can take 10–30 seconds per image.</div>
  </div>

  <div class="footer-note">
    Visual diff finds pixel regions that changed (moved elements, new sections, resized components). Text diff runs on-device OCR (Tesseract.js) to catch renamed or added/removed fields and labels that a pixel diff alone might mis-flag as "changed" due to font rendering. Nothing is uploaded anywhere — save this <code>.html</code> file and open it offline any time (OCR requires an internet connection the first time, to load the recognition engine).
  </div>

  </div><!-- /mode-image -->

  <div class="mode-panel" id="mode-html">
    <div class="html-input-grid">
      <div class="html-input-box">
        <div class="label">Before — page source
          <button class="secondary" id="loadFileA">Load .html file</button>
        </div>
        <input type="file" id="htmlFileA" accept=".html,.htm,text/html" style="display:none">
        <textarea id="htmlTextA" placeholder="Paste the page's HTML source here (right-click the page → View Page Source → copy all, or File → Save Page As → HTML), or click 'Load .html file' above."></textarea>
        <div class="filestat" id="htmlStatA">No source loaded yet</div>
      </div>
      <div class="html-input-box">
        <div class="label">After — page source
          <button class="secondary" id="loadFileB">Load .html file</button>
        </div>
        <input type="file" id="htmlFileB" accept=".html,.htm,text/html" style="display:none">
        <textarea id="htmlTextB" placeholder="Paste the newer version's HTML source here, or click 'Load .html file' above."></textarea>
        <div class="filestat" id="htmlStatB">No source loaded yet</div>
      </div>
    </div>

    <div class="controls">
      <button id="runHtmlDiff" disabled>Compare fields (exact)</button>
      <button id="resetHtml" class="secondary">Reset</button>
      <div class="progress" id="htmlProgress"></div>
    </div>

    <div style="height:16px"></div>

    <div class="summary-banner" id="htmlSummaryBanner" style="display:none"></div>
    <div class="stats-row" id="htmlStats"></div>
    <label class="diff-toggle"><input type="checkbox" id="showRetained"> Show unchanged fields too</label>
    <div id="fieldDiffContainer" class="empty">Paste or load both HTML sources, then click "Compare fields (exact)."</div>

    <div class="footer-note">
      This mode reads real DOM elements (inputs, selects, textareas, label/value pairs) and diffs their exact text — no image recognition involved, so results are deterministic. It works best when the page uses standard form controls with labels; heavily scripted single-page apps that render everything as unlabeled <code>&lt;div&gt;</code>s may need the label association checked manually. To grab page source: open the page, right-click → "View Page Source" (or Ctrl+U), select all, copy, and paste into the box above — or use your browser's "Save As → Webpage, HTML only."
    </div>
  </div><!-- /mode-html -->

</div>

<script>
const state = { imgA:null, imgB:null, fileNameA:'', fileNameB:'' };
const htmlState = { textA:'', textB:'' };

// ---- Mode switching ----
document.querySelectorAll('.mode-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.mode-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('mode-'+btn.dataset.mode).classList.add('active');
  });
});

function setupDrop(dropId, fileId, which){
  const drop = document.getElementById(dropId);
  const input = document.getElementById(fileId);
  drop.addEventListener('click', ()=> input.click());
  drop.addEventListener('dragover', e=>{e.preventDefault(); drop.style.borderColor='var(--accent)';});
  drop.addEventListener('dragleave', ()=> drop.style.borderColor='');
  drop.addEventListener('drop', e=>{
    e.preventDefault();
    if(e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0], which, drop);
  });
  input.addEventListener('change', e=>{
    if(e.target.files[0]) handleFile(e.target.files[0], which, drop);
  });
}

function handleFile(file, which, drop){
  const reader = new FileReader();
  reader.onload = ev=>{
    const img = new Image();
    img.onload = ()=>{
      if(which==='A'){ state.imgA = img; state.fileNameA = file.name; }
      else { state.imgB = img; state.fileNameB = file.name; }
      drop.classList.add('filled');
      drop.innerHTML = `<img src="${ev.target.result}"><div class="filename">${file.name} — ${img.width}×${img.height}</div>`;
      checkReady();
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}

function checkReady(){
  const ready = state.imgA && state.imgB;
  document.getElementById('runVisual').disabled = !ready;
  document.getElementById('runText').disabled = !ready;
}

setupDrop('dropA','fileA','A');
setupDrop('dropB','fileB','B');

document.getElementById('reset').addEventListener('click', ()=> location.reload());

// Tabs
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
    if(tab.dataset.tab==='slider') buildSlider();
  });
});

function setProgress(msg){ document.getElementById('progress').textContent = msg || ''; }

// ---------- VISUAL DIFF ----------
document.getElementById('runVisual').addEventListener('click', runVisualDiff);

function runVisualDiff(){
  setProgress('Analyzing pixels…');
  const w = Math.max(state.imgA.width, state.imgB.width);
  const h = Math.max(state.imgA.height, state.imgB.height);

  const cA = document.createElement('canvas'); cA.width=w; cA.height=h;
  const cB = document.createElement('canvas'); cB.width=w; cB.height=h;
  cA.getContext('2d').drawImage(state.imgA,0,0,w,h);
  cB.getContext('2d').drawImage(state.imgB,0,0,w,h);
  const dataA = cA.getContext('2d').getImageData(0,0,w,h).data;
  const dataB = cB.getContext('2d').getImageData(0,0,w,h).data;

  // downsample factor for clustering performance
  const cell = Math.max(4, Math.round(Math.max(w,h)/300));
  const gw = Math.ceil(w/cell), gh = Math.ceil(h/cell);
  const grid = new Uint8Array(gw*gh);
  const THRESH = 40;

  for(let gy=0; gy<gh; gy++){
    for(let gx=0; gx<gw; gx++){
      let diffCount=0, total=0;
      const x0=gx*cell, y0=gy*cell;
      const x1=Math.min(w,x0+cell), y1=Math.min(h,y0+cell);
      for(let y=y0;y<y1;y+=2){
        for(let x=x0;x<x1;x+=2){
          const idx=(y*w+x)*4;
          const dr=Math.abs(dataA[idx]-dataB[idx]);
          const dg=Math.abs(dataA[idx+1]-dataB[idx+1]);
          const db=Math.abs(dataA[idx+2]-dataB[idx+2]);
          total++;
          if(dr+dg+db > THRESH*3) diffCount++;
        }
      }
      grid[gy*gw+gx] = (diffCount/total > 0.15) ? 1 : 0;
    }
  }

  // connected components (4-dir) over grid
  const visited = new Uint8Array(gw*gh);
  const boxes = [];
  for(let gy=0; gy<gh; gy++){
    for(let gx=0; gx<gw; gx++){
      const i = gy*gw+gx;
      if(grid[i] && !visited[i]){
        // BFS
        let minX=gx,maxX=gx,minY=gy,maxY=gy,count=0;
        const stack=[[gx,gy]];
        visited[i]=1;
        while(stack.length){
          const [cx,cy]=stack.pop();
          count++;
          minX=Math.min(minX,cx); maxX=Math.max(maxX,cx);
          minY=Math.min(minY,cy); maxY=Math.max(maxY,cy);
          const neighbors=[[cx+1,cy],[cx-1,cy],[cx,cy+1],[cx,cy-1]];
          for(const [nx,ny] of neighbors){
            if(nx>=0&&nx<gw&&ny>=0&&ny<gh){
              const ni=ny*gw+nx;
              if(grid[ni] && !visited[ni]){ visited[ni]=1; stack.push([nx,ny]); }
            }
          }
        }
        if(count>=3){ // filter noise
          boxes.push({
            x:minX*cell, y:minY*cell,
            w:(maxX-minX+1)*cell, h:(maxY-minY+1)*cell,
            cells:count
          });
        }
      }
    }
  }
  // merge nearby boxes (simple pass)
  boxes.sort((a,b)=>b.cells-a.cells);

  // draw
  const outCanvas = document.getElementById('visualCanvas');
  outCanvas.width = w; outCanvas.height = h;
  const octx = outCanvas.getContext('2d');
  octx.drawImage(cB,0,0);
  octx.globalAlpha = 1;
  octx.strokeStyle = '#c23b3b';
  octx.lineWidth = Math.max(2, Math.round(w/500));
  octx.font = `bold ${Math.max(12,Math.round(w/120))}px monospace`;
  boxes.forEach((b,i)=>{
    octx.strokeRect(b.x, b.y, b.w, b.h);
    octx.fillStyle = '#c23b3b';
    octx.fillRect(b.x, b.y-Math.round(w/55), Math.round(w/45)+16, Math.round(w/55));
    octx.fillStyle = '#fff';
    octx.fillText((i+1).toString(), b.x+4, b.y-6);
  });

  document.getElementById('visualEmpty').style.display='none';
  const changedPct = (boxes.reduce((s,b)=>s+b.w*b.h,0) / (w*h) * 100).toFixed(1);
  document.getElementById('visualStats').innerHTML = `
    <div class="stat"><div class="num">${boxes.length}</div><div class="lbl">Changed regions</div></div>
