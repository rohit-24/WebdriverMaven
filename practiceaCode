-- ============================================================
-- SCHEMA-LEVEL HEALTH CHECK
-- Works with standard CONNECT/RESOURCE privileges (no SELECT_CATALOG_ROLE needed)
-- Run as a script (F5) in SQL Developer to see all result sets
-- ============================================================

-- 1. Connectivity & session context
SELECT SYS_CONTEXT('USERENV','DB_NAME')        AS db_name,
       SYS_CONTEXT('USERENV','INSTANCE_NAME')  AS instance_name,
       SYS_CONTEXT('USERENV','SERVER_HOST')    AS host,
       SYS_CONTEXT('USERENV','SESSION_USER')   AS logged_in_as,
       SYSDATE                                  AS server_time
FROM dual;

-- 2. Invalid objects in your own schema (broken views/procedures/triggers)
SELECT object_name, object_type, status, last_ddl_time
FROM user_objects
WHERE status != 'VALID'
ORDER BY last_ddl_time DESC;

-- 3. Compile errors on your PL/SQL objects (if any invalid objects found above)
SELECT name, type, line, position, text
FROM user_errors
ORDER BY name, sequence;

-- 4. Table stats freshness (stale/missing stats can cause bad query plans)
SELECT table_name, num_rows, last_analyzed, status
FROM user_tables
ORDER BY last_analyzed NULLS FIRST;

-- 5. Schema space usage vs quota
SELECT tablespace_name,
       ROUND(bytes/1024/1024, 2)     AS used_mb,
       ROUND(max_bytes/1024/1024, 2) AS quota_mb
FROM user_ts_quotas;

-- 6. Scheduled jobs owned by this schema (batch loads, file transfers, etc.)
SELECT job_name, enabled, state, last_start_date, next_run_date
FROM user_scheduler_jobs;

-- 7. DB-wide invalid object count by owner
--    Requires SELECT ANY TABLE (works on TI_DEV1; will return only your own
--    schema's rows, or fail, on accounts without that privilege such as TI_SIT)
SELECT owner, COUNT(*) AS invalid_count
FROM all_objects
WHERE status != 'VALID'
GROUP BY owner
ORDER BY invalid_count DESC;
