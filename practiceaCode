class CucumberParser:

    @staticmethod
    def extract_squad_name(tags):
        """Extract squad name from tags like '@squad_Jatayu'."""
        for tag in tags:
            if "@squad_" in tag:
                return tag.split("_", 1)[1]
        return "Unknown"

    @staticmethod
    def extract_failures(karate_json):
        failures = []
        for feature in karate_json:
            feature_name = feature.get("name", "")
            tags = [tag.get("name", "") for tag in feature.get("tags", [])]
            for element in feature.get("elements", []):
                scenario_name = element.get("name", "")
                steps = element.get("steps", [])
                failed_steps = [step for step in steps if step.get("result", {}).get("status") == "failed"]
                if failed_steps:
                    failures.append({
                        "feature_name": feature_name,
                        "scenario_name": scenario_name,
                        "failed_steps": failed_steps,
                        "tags": tags
                    })
        return failures

    @staticmethod
    def build_structured_failure(failure):
        """Return a full failure dictionary with additional metadata."""
        tags = failure.get("tags", [])
        squad_name = CucumberParser.extract_squad_name(tags)

        return {
            "feature_name": failure.get("feature_name", ""),
            "scenario_name": failure.get("scenario_name", ""),
            "failed_steps": failure.get("failed_steps", []),
            "tags": tags,
            "file_path": failure.get("file_path", "N/A"),
            "line_number": failure.get("line_number", "N/A"),
            "squad_name": squad_name
        }



