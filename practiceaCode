async waitForResponse(
  url: string,
  method: string,
  timeout = 30000
): Promise<Response> {
  try {
    // Start waiting before the action that triggers the request
    const response = await page.waitForResponse((response) => {
      return this.isMatchingResponse(response, url, method);
    }, { timeout });

    if (!response) {
      throw new Error(`No matching response found for ${method} ${url}`);
    }

    return response;
  } catch (error) {
    throw new Error(`Failed to intercept response for ${method} ${url}: ${error}`);
  }
}

isMatchingResponse(response: Response, url: string, method: string): boolean {
  try {
    const req = response.request();
    return (
      response.url() === url && // exact match preferred
      req.method().toLowerCase() === method.toLowerCase()
    );
  } catch (err) {
    console.error('Error in matching response:', err);
    return false;
  }
}
