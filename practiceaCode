import re

def process_test_results(response_text, scenario_title):
    """
    Parses structured LLM response into JSON format.
    """
    cleaned_text = clean_response(response_text)

    return {
        "scenario": scenario_title,
        "summary": cleaned_text,
        "analysis": {
            "api_endpoint": extract_endpoint_from_section(cleaned_text),
            "http_method": extract_method_from_section(cleaned_text),
            "failure_reason": extract_section(cleaned_text, "2. Failure"),
            "suggested_fix": extract_section(cleaned_text, "3. Fixes"),
            "test_improvement": extract_section(cleaned_text, "4. Suggestions")
        }
    }

def clean_response(text):
    return text.strip()

def extract_section(text, heading_startswith):
    """
    Extracts the paragraph after a numbered heading like "2. Failure Reason:"
    """
    pattern = rf"{heading_startswith}.*?:?\s*(.*?)(?=\n\d\.|\Z)"
    match = re.search(pattern, text, re.DOTALL | re.IGNORECASE)
    return match.group(1).strip() if match else "Not found"

def extract_endpoint_from_section(text):
    """
    Attempt to find endpoint path (e.g., /api/v1/something)
    """
    match = re.search(r"\b(/[a-zA-Z0-9_\-/]+)\b", text)
    return match.group(1) if match else "Not clearly identified"

def extract_method_from_section(text):
    """
    Extracts HTTP method if mentioned.
    """
    match = re.search(r"\b(GET|POST|PUT|DELETE|PATCH)\b", text, re.IGNORECASE)
    return match.group(1).upper() if match else "Unknown"
