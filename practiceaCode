import { LLM } from "@langchain/core/language_models/llms";
import type { BaseLanguageModelParams } from "@langchain/core/language_models/base";

export class GatewayLLM extends LLM {
  constructor(fields: BaseLanguageModelParams = {}) {
    super(fields);
  }

  _llmType(): string {
    return "gateway-llm";
  }

  async _call(prompt: string): Promise<string> {
    const response = await fetch(
      "https://stork.apps.ocp8.uat.xyz.com/v1/projects/xyz-mod-adag-d4q9v/locations/asia-southeast1/publishers/anthropic/models/claude-3.5-sonnet@20240620:streamRawPredict",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${process.env.LLM_GATEWAY_TOKEN}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          anthropic_version: "vertex-2023-10-16",
          messages: [
            {
              role: "user",
              content: [{ type: "text", text: prompt }],
            },
          ],
        }),
      }
    );

    const data = await response.json();
    return data?.content?.[0]?.text ?? "";
  }
}
