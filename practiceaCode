## NEW — `src/pages/middleware/WasConsolePage.js`

```js
const BasePage = require('../BasePage');

const LOCATORS = {
  usernameInput: '#j_username',
  passwordInput: '#j_password',
  loginButton: 'input[type=submit]',
  // Excludes the hidden #filterControls tbody - only real data rows
  dataRows: 'tbody:not(#filterControls) tr.table-row',
  nameLink: 'a[target="statuswindow"]',
  statusIcon: 'img[name="statusIcon"]'
};

/**
 * WasConsolePage
 * ------------------------------------------------------------------
 * Single shared page object for the IBM WAS Admin Console, reused
 * across EVERY application - not one class per app, since the console
 * itself is the same product everywhere. Only wasConsoleUrl and
 * credentials differ per app/env, both supplied via config.
 *
 * Design: no JVM names or counts are hardcoded. The console URL is
 * already scoped to one app/cell, so every row found on the
 * "Middleware servers" landing page belongs to this app - just read
 * every row and confirm the status icon says "Started".
 * ------------------------------------------------------------------
 */
class WasConsolePage extends BasePage {
  async login({ username, password }) {
    await this.waitForVisible(LOCATORS.usernameInput);
    await this.page.locator(LOCATORS.usernameInput).fill(username);
    await this.page.locator(LOCATORS.passwordInput).fill(password);
    await this.page.locator(LOCATORS.loginButton).click();
    // Console redirects straight to "Middleware servers" list post-login.
    await this.waitForVisible(LOCATORS.dataRows);
  }

  /**
   * Reads every server row on the "Middleware servers" page.
   * Confirmed from DOM inspection:
   *   running -> <img name="statusIcon" alt="Started" title="Started" src=".../running.gif">
   *   anything else -> different title text (Stopped, Partial Start, etc.)
   */
  async getAllServerStatuses() {
    const rows = this.page.locator(LOCATORS.dataRows);
    const count = await rows.count();
    const results = [];

    for (let i = 0; i < count; i++) {
      const row = rows.nth(i);

      // Some rows (e.g. web servers) may not have the statuswindow link -
      // fall back to the row's raw text so nothing is silently skipped.
      const nameLink = row.locator(LOCATORS.nameLink);
      const name = (await nameLink.count()) > 0
        ? (await nameLink.first().innerText()).trim()
        : (await row.innerText()).split('\n')[0].trim();

      const icon = row.locator(LOCATORS.statusIcon).first();
      const iconCount = await icon.count();

      if (iconCount === 0) {
        results.push({ name, status: 'UNKNOWN', reason: 'no status icon found' });
        continue;
      }

      const title = ((await icon.getAttribute('title')) || '').trim();
      results.push({
        name,
        status: title === 'Started' ? 'RUNNING' : 'NOT_RUNNING',
        reason: title || 'no title attribute'
      });
    }

    return results;
  }
}

module.exports = WasConsolePage;
```

