 function generateFeatureForMarket(market) {
  const featurePath = path.resolve(`cypress/e2e/features/search_${market}.feature`);

  if (!fs.existsSync(featurePath)) {
    console.warn(`⚠️ Feature template not found for ${market}: ${featurePath}`);
    return;
  }

  let featureContent = fs.readFileSync(featurePath, "utf8");
  const jsonData = readExcelSheet("TestData/LV_Data.xlsx", market);

  if (!jsonData.length) {
    console.warn(`⚠️ No data found for market ${market}, skipping...`);
    return;
  }

  // Build Examples dynamically
  const headers = Object.keys(jsonData[0]);
  const headerRow = `      | ${headers.join(" | ")} |`;
  const dataRows = jsonData
    .map(r => `      | ${headers.map(h => r[h]).join(" | ")} |`)
    .join("\n");

  // Replace placeholder row
  featureContent = featureContent.replace(/\|.*placeholder.*\|/, `${headerRow}\n${dataRows}`);

  // Overwrite same feature file
  fs.writeFileSync(featurePath, featureContent, "utf8");

  console.log(`✅ Updated ${featurePath} with ${jsonData.length} rows`);
}
