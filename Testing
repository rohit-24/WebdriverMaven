
function generateFeatureFromExcel(market) {
  const jsonData = readExcelSheet("TestData/LV_Data.xlsx", market);

  if (!jsonData.length) {
    throw new Error(`No data found in sheet ${market}`);
  }

  const rows = jsonData.map(r => `    | ${r.CIN} | ${market} |`).join("\n");

  const templatePath = path.resolve("cypress/e2e/features/search.template.feature");
  let feature = fs.readFileSync(templatePath, "utf8");

  // Debug
  console.log(`🔎 Before replace for ${market}:\n`, feature);

  // Replace placeholder row
  feature = feature.replace(/\|.*placeholder.*\|.*\|/, rows);

  // Write updated feature
  const outPath = path.resolve(`cypress/e2e/features/search_${market}.feature`);
  fs.writeFileSync(outPath, feature, "utf8");

  console.log(`✅ Generated ${outPath} with ${jsonData.length} CINs`);
}
