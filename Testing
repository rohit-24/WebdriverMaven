    Examples:
      | placeholder |



const { defineConfig } = require("cypress");
const fs = require("fs");
const path = require("path");
const { readExcelSheet } = require("./cypress/support/excelUtils");

function generateFeaturesFromTemplate() {
  const templatePath = path.resolve("cypress/e2e/features/search.template.feature");
  const templateContent = fs.readFileSync(templatePath, "utf8");

  // Find all tags like @SG, @HK, @MY
  const marketTags = [...templateContent.matchAll(/@([A-Z]+)/g)].map(m => m[1]);

  marketTags.forEach(market => {
    const jsonData = readExcelSheet("TestData/LV_Data.xlsx", market);

    if (!jsonData.length) {
      console.warn(`⚠️ No data found for market ${market}, skipping...`);
      return;
    }

    // Build Examples dynamically from Excel sheet
    const headers = Object.keys(jsonData[0]);
    const headerRow = `      | ${headers.join(" | ")} |`;
    const dataRows = jsonData.map(r => `      | ${headers.map(h => r[h]).join(" | ")} |`).join("\n");

    // Replace placeholder row in template
    let feature = templateContent.replace(/\|.*placeholder.*\|/, `${headerRow}\n${dataRows}`);

    // Write market-specific feature
    const outPath = path.resolve(`cypress/e2e/features/search_${market}.feature`);
    fs.writeFileSync(outPath, feature, "utf8");

    console.log(`✅ Generated feature: ${outPath} with ${jsonData.length} rows`);
  });
}

module.exports = defineConfig({
  e2e: {
    setupNodeEvents(on, config) {
      // Generate features before tests
      generateFeaturesFromTemplate();
      return config;
    },
    specPattern: "cypress/e2e/features/*.feature",
    supportFile: "cypress/support/e2e.js"
  }
});
