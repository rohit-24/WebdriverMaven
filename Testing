// cypress/support/excelUtils.js
const xlsx = require("xlsx");

function readExcelSheet(filePath, sheetName) {
  const workbook = xlsx.readFile(filePath);
  const sheet = workbook.Sheets[sheetName];
  return xlsx.utils.sheet_to_json(sheet);
}

module.exports = { readExcelSheet };



const { defineConfig } = require("cypress");
const fs = require("fs");
const path = require("path");
const { readExcelSheet } = require("./cypress/support/excelUtils");

function generateFeatureFromExcel(market) {
  const jsonData = readExcelSheet("TestData/LV_Data.xlsx", market);

  // Build Examples dynamically
  const rows = jsonData.map(r => `    | ${r.CIN} | ${market} |`).join("\n");

  // Load template
  const templatePath = path.resolve("cypress/e2e/features/search.template.feature");
  let feature = fs.readFileSync(templatePath, "utf8");

  // Replace placeholder
  feature = feature.replace(/\| placeholder \| SG \|/, rows);

  // Write actual feature
  const outPath = path.resolve("cypress/e2e/features/search.feature");
  fs.writeFileSync(outPath, feature, "utf8");

  console.log(`✅ Generated feature with ${jsonData.length} CINs for ${market}`);
}

module.exports = defineConfig({
  e2e: {
    setupNodeEvents(on, config) {
      // Generate feature(s) before tests start
      generateFeatureFromExcel("SG");
      generateFeatureFromExcel("HK"); // add more markets if needed

      return config;
    },
    specPattern: "cypress/e2e/features/*.feature"
  }
});



